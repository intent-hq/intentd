+import { EventEmitter } from "node:events";
+import { PassThrough, Readable, Writable } from "node:stream";
+import { createInterface } from "node:readline";
+import { ndJsonStream } from "@agentclientprotocol/sdk";
+import { ClaudeAcpAgent, runAcp } from "../dist/acp-agent.js";
+import { SettingsManager } from "../dist/settings.js";
+import { RpcLines, connectMcp, deferred } from "./mcp-peer.mjs";
+
+// Replace configuration discovery only. The real adapter's createSession,
+// Query constructor, control serialization and explicit dispatcher still run.
+SettingsManager.prototype.initialize = async function () {
+  this.initialized = true;
+  this.effective = {};
+};
+SettingsManager.prototype.getSettings = function () {
+  return this.effective;
+};
+
+export class ScriptedQueryProcess extends EventEmitter {
+  constructor(options) {
+    super();
+    this.stdin = new PassThrough();
+    this.stdout = new PassThrough();
+    this.killed = false;
+    this.exitCode = null;
+    this.frames = [];
+    this.clients = new Map();
+    this.initializations = 0;
+    this.hold = null;
+    this.resultOverride = null;
+    this.error = null;
+    this.onSet = null;
+    this.setEntered = deferred();
+    this.statusEntered = deferred();
+    this.statusHold = null;
+    this.options = options;
+    const index = options.args.indexOf("--mcp-config");
+    this.initial = index === -1 ? {} : JSON.parse(options.args[index + 1]).mcpServers;
+    this.lines = createInterface({ input: this.stdin });
+    this.lines.on("line", (line) => {
+      const frame = JSON.parse(line);
+      this.frames.push(frame);
+      if (frame.type === "control_request") {
+        this.handle(frame).then(
+          (response) => this.respond(frame, response),
+          (error) => this.respond(frame, null, error.message),
+        );
+      }
+    });
+    this.stdin.on("end", () => this.kill());
+  }
+  respond(frame, response, error) {
+    if (this.killed) return;
+    this.stdout.write(
+      `${JSON.stringify({
+        type: "control_response",
+        response: {
+          subtype: error ? "error" : "success",
+          request_id: frame.request_id,
+          ...(error ? { error } : { response }),
+        },
+      })}\n`,
+    );
+  }
+  async add(name, config) {
+    if (this.clients.has(name)) {
+      if (JSON.stringify(this.clients.get(name).config) !== JSON.stringify(config))
+        throw new Error("fixture detected alias redirection");
+      return false;
+    }
+    this.clients.set(name, await connectMcp(config));
+    return true;
+  }
+  async handle(frame) {
+    const request = frame.request;
+    if (request.subtype === "initialize") {
+      this.initializations++;
+      for (const [name, config] of Object.entries(this.initial)) await this.add(name, config);
+      return {
+        commands: [],
+        models: [{ value: "fixture-model", displayName: "Fixture", description: "local fixture" }],
+        account: {},
+      };
+    }
+    if (request.subtype === "mcp_status") {
+      this.statusEntered.resolve();
+      if (this.statusHold) await this.statusHold.promise;
+      return {
+        mcpServers: [...this.clients.keys()].map((name) => ({ name, status: "connected" })),
+      };
+    }
+    if (request.subtype === "mcp_set_servers") {
+      this.setEntered.resolve(request);
+      this.onSet?.(request);
+      if (this.hold) await this.hold.promise;
+      if (this.error) throw new Error(this.error);
+      const added = [];
+      const errors = {};
+      const removed = [];
+      for (const name of this.clients.keys()) {
+        if (!(name in request.servers)) removed.push(name);
+      }
+      for (const [name, config] of Object.entries(request.servers)) {
+        try {
+          if (await this.add(name, config)) added.push(name);
+        } catch (error) {
+          errors[name] = error.message;
+        }
+      }
+      return this.resultOverride ?? { added, removed, errors };
+    }
+    if (["set_permission_mode", "set_model", "apply_flag_settings"].includes(request.subtype))
+      return {};
+    if (request.subtype === "interrupt") return {};
+    throw new Error(`unexpected control request: ${request.subtype}`);
+  }
+  kill() {
+    if (this.killed) return true;
+    this.killed = true;
+    this.exitCode = 0;
+    this.hold?.resolve();
+    this.statusHold?.resolve();
+    for (const client of this.clients.values()) client.close();
+    this.lines.close();
+    this.stdout.end();
+    this.emit("exit", 0, null);
+    return true;
+  }
+}
+
+const quiet = { log() {}, error() {}, warn() {}, debug() {} };
+
+export async function adapterFixture(
+  t,
+  capabilities = { _meta: { intentCallbackRegistration: { version: 1 } } },
+) {
+  const input = new PassThrough();
+  const output = new PassThrough();
+  const stream = ndJsonStream(Writable.toWeb(output), Readable.toWeb(input));
+  const { agent, connection } = runAcp(quiet, stream);
+  const processes = [];
+  const originalCreate = agent.createSession.bind(agent);
+  let authProbes = 0;
+  const allocated = [];
+  agent.probeCliAuthStatus = async () => {
+    authProbes++;
+    return null;
+  };
+  agent.claudeSubscriptionGuardActive = () => false;
+  agent.sendAvailableCommandsUpdate = async () => {};
+  agent.createSession = async (params, options) => {
+    const result = await originalCreate(
+      {
+        ...params,
+        _meta: {
+          ...params._meta,
+          claudeCode: {
+            options: {
+              ...params._meta?.claudeCode?.options,
+              settingSources: [],
+              spawnClaudeCodeProcess(spawnOptions) {
+                const process = new ScriptedQueryProcess(spawnOptions);
+                processes.push(process);
+                return process;
+              },
+            },
+          },
+        },
+      },
+      options,
+    );
+    allocated.push(agent.sessions[result.sessionId]);
+    return result;
+  };
+  const rpc = new RpcLines(output, input);
+  t.after(async () => {
+    for (const process of processes) process.kill();
+    for (const session of allocated) agent.closeQueryStream(session);
+    rpc.close();
+    output.end();
+    await connection.disconnect?.();
+  });
+  const init = await rpc.request("initialize", {
+    protocolVersion: 1,
+    clientCapabilities: capabilities,
+  });
+  return {
+    agent,
+    rpc,
+    init,
+    processes,
+    authProbes: () => authProbes,
+    async newSession(servers = [], options = {}) {
+      return rpc.request("session/new", {
+        cwd: process.env.CALLBACK_TEST_ROOT,
+        mcpServers: servers.map(([name, peer]) => ({
+          name,
+          command: peer.config.command,
+          args: peer.config.args,
+          env: [],
+        })),
+        _meta: { claudeCode: { options } },
+      });
+    },
+  };
+}
+
+export async function bareAgent() {
+  const agent = new ClaudeAcpAgent({}, quiet);
+  agent.probeCliAuthStatus = async () => null;
+  return agent;
+}
