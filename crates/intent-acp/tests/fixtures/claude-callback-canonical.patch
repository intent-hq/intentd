+import { spawn, spawnSync } from "node:child_process";
+import assert from "node:assert/strict";
+import { createInterface } from "node:readline";
+import { mkdtempSync, mkdirSync, realpathSync, rmSync } from "node:fs";
+import { resolve } from "node:path";
+
+const root = resolve(import.meta.dirname, "..");
+const dependencies = realpathSync(`${root}/node_modules`);
+if (!dependencies.startsWith(`${root}/`))
+  throw new Error("Fixture dependencies must be self-contained");
+mkdirSync(`${root}/.dev`, { recursive: true });
+const scratch = mkdtempSync(`${root}/.dev/hermetic-`);
+const env = {
+  PATH: process.env.PATH,
+  CALLBACK_TEST_ROOT: scratch,
+  CLAUDE_CONFIG_DIR: `${scratch}/claude-config`,
+  XDG_CONFIG_HOME: `${scratch}/xdg`,
+  TMPDIR: scratch,
+  NODE_OPTIONS: "",
+  DD_TRACE_ENABLED: "false",
+  DD_INJECTION_ENABLED: "false",
+  DD_INSTRUMENT_SERVICE_WITH_APM: "false",
+  DD_INJECT_NATIVE: "never",
+  DD_INSTRUMENTATION_TELEMETRY_ENABLED: "false",
+  DO_NOT_TRACK: "1",
+  CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC: "1",
+};
+
+async function checkDefaultStdio() {
+  // This separate permission-confined process exercises the unchanged default
+  // stream path. Only CLI auth probing is replaced, just as in the Query fixture.
+  const code = `
+        import { runAcp } from './dist/lib.js';
+        const { agent } = runAcp({ log() {}, warn() {}, error() {} });
+        agent.probeCliAuthStatus = async () => {};
+    `;
+  const child = spawn(
+    process.execPath,
+    [
+      "--permission",
+      `--allow-fs-read=${root}`,
+      `--allow-fs-read=${dependencies}`,
+      `--allow-fs-write=${scratch}`,
+      "--input-type=module",
+      "--eval",
+      code,
+    ],
+    { cwd: root, env, stdio: ["pipe", "pipe", "pipe"] },
+  );
+  const lines = createInterface({ input: child.stdout });
+  const closed = new Promise((resolve) => child.once("close", resolve));
+  const timer = setTimeout(() => child.kill(), 5000);
+  try {
+    const reply = new Promise((resolve, reject) => {
+      child.once("error", reject);
+      child.once("exit", () => reject(new Error("Default stdio exited before initialize")));
+      lines.on("line", (line) => {
+        try {
+          const frame = JSON.parse(line);
+          if (frame.id === "ordinary-stdio") resolve(frame);
+        } catch (error) {
+          reject(error);
+        }
+      });
+    });
+    child.stdin.write(
+      JSON.stringify({
+        jsonrpc: "2.0",
+        id: "ordinary-stdio",
+        method: "initialize",
+        params: { protocolVersion: 1, clientCapabilities: {} },
+      }) + "\n",
+    );
+    const frame = await reply;
+    assert.equal(frame.error, undefined);
+    assert.equal(frame.result.protocolVersion, 1);
+    assert.equal(frame.result.agentInfo.name, "@agentclientprotocol/claude-agent-acp");
+    assert.equal(frame.result._meta.intentCallbackRegistration, undefined);
+    console.log("Default runAcp(logger) stdio initialize: passed");
+  } finally {
+    clearTimeout(timer);
+    lines.close();
+    child.stdin.end();
+    child.kill();
+    await closed;
+  }
+}
+try {
+  await checkDefaultStdio();
+  const result = spawnSync(
+    process.execPath,
+    [
+      "--permission",
+      `--allow-fs-read=${root}`,
+      `--allow-fs-read=${dependencies}`,
+      `--allow-fs-write=${scratch}`,
+      "--test",
+      "--test-isolation=none",
+      "--test-concurrency=1",
+      "--test-timeout=20000",
+      ...process.argv.slice(2),
+      "tests/callback-registration.test.mjs",
+    ],
+    { cwd: root, env, stdio: "inherit" },
+  );
+  process.exitCode = result.status ?? 1;
+} finally {
+  rmSync(scratch, { recursive: true, force: true });
+}
