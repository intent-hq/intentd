diff --git a/src/callback-registration.ts b/src/callback-registration.ts
new file mode 100644
index 0000000..4b29a64
--- /dev/null
+++ b/src/callback-registration.ts
@@ -0,0 +1,291 @@
+import { randomUUID } from "node:crypto";
+import { type ClientCapabilities, RequestError } from "@agentclientprotocol/sdk";
+import type {
+  McpServerConfig,
+  McpSetServersResult,
+  McpStdioServerConfig,
+  Query,
+} from "@anthropic-ai/claude-agent-sdk";
+
+// Transport correlation only: none of these identifiers is repository authority.
+export const CALLBACK_META = "intentCallbackRegistration";
+export const CALLBACK_METHOD = "_intent/session/register_mcp_callback";
+export const CALLBACK_VERSION = 1;
+export const CALLBACK_TIMEOUT_MS = 5000;
+
+export type CallbackRegistrationRequest = Readonly<{
+  version: typeof CALLBACK_VERSION;
+  sessionId: string;
+  queryReceipt: string;
+  registrationId: string;
+  server: Readonly<{
+    type: "stdio";
+    command: string;
+    args: readonly string[];
+    env?: Readonly<Record<string, string>>;
+  }>;
+}>;
+
+type CallbackReason = string | { code: string; message: string };
+
+export type CallbackRegistrationResponse = {
+  version: typeof CALLBACK_VERSION;
+  sessionId: string;
+  queryReceipt: string;
+  registrationId: string;
+  serverName: string;
+  status: "not-dispatched" | "uncertain" | "stale" | "failed" | "acknowledged";
+  result: McpSetServersResult | null;
+  reason?: CallbackReason;
+};
+
+function record(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+
+function keys(value: Record<string, unknown>, allowed: readonly string[]): boolean {
+  return Object.keys(value).every((key) => allowed.includes(key));
+}
+
+function strings(value: unknown): value is string[] {
+  return Array.isArray(value) && value.every((item) => typeof item === "string");
+}
+
+function stringRecord(value: unknown): value is Record<string, string> {
+  return record(value) && Object.values(value).every((item) => typeof item === "string");
+}
+
+export function callbackNegotiated(capabilities: ClientCapabilities | undefined): boolean {
+  const offered = capabilities?._meta?.[CALLBACK_META];
+  return record(offered) && keys(offered, ["version"]) && offered.version === CALLBACK_VERSION;
+}
+
+export function callbackCapability(capabilities: ClientCapabilities | undefined) {
+  return callbackNegotiated(capabilities)
+    ? { [CALLBACK_META]: { version: CALLBACK_VERSION, method: CALLBACK_METHOD } }
+    : {};
+}
+
+export function parseCallbackRegistration(value: unknown): CallbackRegistrationRequest {
+  const invalid = (): never => {
+    throw RequestError.invalidParams(undefined, "Invalid callback registration v1");
+  };
+  if (
+    !record(value) ||
+    !keys(value, ["version", "sessionId", "queryReceipt", "registrationId", "server"]) ||
+    value.version !== CALLBACK_VERSION ||
+    typeof value.sessionId !== "string" ||
+    !value.sessionId ||
+    typeof value.queryReceipt !== "string" ||
+    !value.queryReceipt ||
+    typeof value.registrationId !== "string" ||
+    !/^[a-zA-Z0-9_-]{1,128}$/.test(value.registrationId)
+  ) {
+    return invalid();
+  }
+  const server = value.server;
+  if (
+    !record(server) ||
+    !keys(server, ["type", "command", "args", "env"]) ||
+    server.type !== "stdio" ||
+    typeof server.command !== "string" ||
+    !server.command ||
+    !strings(server.args) ||
+    (server.env !== undefined && !stringRecord(server.env))
+  ) {
+    return invalid();
+  }
+  // An ACP caller cannot alter a queued configuration after capture.
+  return Object.freeze({
+    version: CALLBACK_VERSION,
+    sessionId: value.sessionId,
+    queryReceipt: value.queryReceipt,
+    registrationId: value.registrationId,
+    server: Object.freeze({
+      type: "stdio",
+      command: server.command,
+      args: Object.freeze([...server.args]),
+      ...(server.env !== undefined && { env: Object.freeze({ ...server.env }) }),
+    }),
+  });
+}
+
+function sdkResult(value: unknown): McpSetServersResult | null {
+  if (
+    !record(value) ||
+    !strings(value.added) ||
+    !strings(value.removed) ||
+    !stringRecord(value.errors)
+  ) {
+    return null;
+  }
+  return { added: [...value.added], removed: [...value.removed], errors: { ...value.errors } };
+}
+
+function sdkServer(server: CallbackRegistrationRequest["server"]): McpStdioServerConfig {
+  // The SDK declares mutable containers. Give it its own frozen copy without
+  // casting away the readonly contract of the captured request.
+  const args = [...server.args];
+  Object.freeze(args);
+  const env = server.env === undefined ? undefined : { ...server.env };
+  if (env !== undefined) {
+    Object.freeze(env);
+  }
+  return Object.freeze({ type: "stdio", command: server.command, args, ...(env && { env }) });
+}
+
+/** One original Query allocation. It is never rebound or recovered by session ID. */
+export class CallbackRegistration {
+  #query: Query;
+  #servers: Map<string, McpServerConfig>;
+  #used = new Set<string>();
+  #tail: Promise<void> = Promise.resolve();
+  #blocked = false;
+  #receipt = randomUUID();
+
+  constructor(query: Query, servers: Record<string, McpServerConfig> | undefined) {
+    this.#query = query;
+    // Preserve every original SDK/user entry, including SDK server instances.
+    // Only this helper adds entries; it never removes or redirects an entry.
+    this.#servers = new Map(
+      Object.entries(servers ?? {}).map(([name, config]) => [
+        name,
+        config.type === "sdk" ? { ...config } : structuredClone(config),
+      ]),
+    );
+  }
+
+  metadata() {
+    return { [CALLBACK_META]: { version: CALLBACK_VERSION, queryReceipt: this.#receipt } };
+  }
+
+  register(
+    params: CallbackRegistrationRequest,
+    query: Query,
+    isCurrent: () => boolean,
+    signal?: AbortSignal,
+  ): Promise<CallbackRegistrationResponse> {
+    if (params.queryReceipt !== this.#receipt || query !== this.#query || !isCurrent()) {
+      throw RequestError.invalidParams(undefined, "Stale or closed callback allocation");
+    }
+    if (this.#used.has(params.registrationId)) {
+      throw RequestError.invalidParams(
+        undefined,
+        "Callback registration identity is immutable and cannot be reused",
+      );
+    }
+    this.#used.add(params.registrationId);
+    // The caller cannot choose an alias belonging to a pending/user/plugin server.
+    const serverName = `intent-callback-${randomUUID()}`;
+    let dispatched = false;
+    let abandoned = false;
+    const response = (
+      status: CallbackRegistrationResponse["status"],
+      reason?: CallbackReason,
+      result: McpSetServersResult | null = null,
+    ): CallbackRegistrationResponse => ({
+      version: CALLBACK_VERSION,
+      sessionId: params.sessionId,
+      queryReceipt: this.#receipt,
+      registrationId: params.registrationId,
+      serverName,
+      status,
+      result,
+      ...(reason && { reason }),
+    });
+    const work = this.#tail.then(async () => {
+      if (abandoned || signal?.aborted) {
+        return response("not-dispatched", "cancelled");
+      }
+      if (!isCurrent()) {
+        return response("not-dispatched", "stale");
+      }
+      if (this.#blocked) {
+        return response("not-dispatched", "previous-outcome-uncertain-or-failed");
+      }
+      try {
+        // Include settings/plugin names in collision detection. This reads
+        // the same Query; it is not a new initialization or config write.
+        const status = await this.#query.mcpServerStatus();
+        if (abandoned || signal?.aborted) {
+          return response("not-dispatched", "cancelled");
+        }
+        if (!isCurrent()) {
+          return response("not-dispatched", "stale");
+        }
+        if (
+          !Array.isArray(status) ||
+          !status.every((entry) => record(entry) && typeof entry.name === "string")
+        ) {
+          return response("not-dispatched", "invalid-server-status");
+        }
+        if (this.#servers.has(serverName) || status.some((entry) => entry.name === serverName)) {
+          return response("not-dispatched", "registration-name-collision");
+        }
+        this.#servers.set(serverName, sdkServer(params.server));
+        dispatched = true;
+        const raw = await this.#query.setMcpServers(Object.fromEntries(this.#servers));
+        const result = sdkResult(raw);
+        if (!result) {
+          this.#blocked = true;
+          return response("uncertain", "invalid-sdk-result");
+        }
+        // A timeout/cancellation response is final even if the SDK later
+        // finishes. Never use that late finish to resume registration work.
+        if (!isCurrent()) {
+          return response("stale", "allocation-replaced-or-closed", result);
+        }
+        if (result.removed.length || Object.keys(result.errors).length) {
+          this.#blocked = true;
+          return response("failed", "sdk-reported-errors-or-removals", result);
+        }
+        if (!result.added.includes(serverName)) {
+          this.#blocked = true;
+          return response("uncertain", "registration-not-acknowledged", result);
+        }
+        return response("acknowledged", undefined, result);
+      } catch (error) {
+        if (dispatched) {
+          this.#blocked = true;
+        }
+        return response(dispatched ? "uncertain" : "not-dispatched", {
+          code: "sdk-error",
+          message: error instanceof Error ? error.message : String(error),
+        });
+      }
+    });
+    // Serialization follows the REAL SDK completion, not the caller's timer.
+    this.#tail = work.then(
+      () => {},
+      () => {},
+    );
+    return new Promise((resolve) => {
+      let settled = false;
+      const finish = (value: CallbackRegistrationResponse) => {
+        if (settled) {
+          return;
+        }
+        settled = true;
+        clearTimeout(timer);
+        signal?.removeEventListener("abort", cancel);
+        resolve(value);
+      };
+      const abandon = (reason: string) => {
+        abandoned = true;
+        if (dispatched) {
+          this.#blocked = true;
+        }
+        finish(response(dispatched ? "uncertain" : "not-dispatched", reason));
+      };
+      const cancel = () => abandon("cancelled");
+      const timer = setTimeout(() => abandon("timeout"), CALLBACK_TIMEOUT_MS);
+      signal?.addEventListener("abort", cancel, { once: true });
+      if (signal?.aborted) {
+        cancel();
+      }
+      work.then(finish, (error) =>
+        finish(response("uncertain", { code: "internal", message: String(error) })),
+      );
+    });
+  }
+}
diff --git a/tests/callback-registration.test.mjs b/tests/callback-registration.test.mjs
new file mode 100644
index 0000000..a755271
--- /dev/null
+++ b/tests/callback-registration.test.mjs
@@ -0,0 +1,469 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { bareAgent, adapterFixture } from "./scripted-query.mjs";
+import { mcpPeer, deferred } from "./mcp-peer.mjs";
+import { readFileSync } from "node:fs";
+import { spawnSync } from "node:child_process";
+import { homedir } from "node:os";
+
+const METHOD = "_intent/session/register_mcp_callback";
+function request(opened, peer, registrationId = "fresh") {
+  return {
+    version: 1,
+    sessionId: opened.sessionId,
+    queryReceipt: opened._meta.intentCallbackRegistration.queryReceipt,
+    registrationId,
+    server: peer.config,
+  };
+}
+
+async function peer(t, tag) {
+  const p = await mcpPeer(tag);
+  t.after(() => p.close());
+  return p;
+}
+
+test("original initialize explicitly negotiates callback registration v1", async () => {
+  const agent = await bareAgent();
+  const init = await agent.initialize({
+    protocolVersion: 1,
+    clientCapabilities: {
+      _meta: { intentCallbackRegistration: { version: 1 } },
+    },
+  });
+  assert.deepEqual(init._meta.intentCallbackRegistration, {
+    version: 1,
+    method: "_intent/session/register_mcp_callback",
+  });
+});
+
+test("real dispatcher and SDK control deliver initialize/list/call on the same original Query", async (t) => {
+  const pending = await peer(t, "pending ordinary route");
+  const user = await peer(t, "user ordinary route");
+  const fresh = await peer(t, "fresh callback route");
+  const f = await adapterFixture(t);
+  const opened = await f.newSession([
+    ["workspace-mcp", pending],
+    ["user", user],
+  ]);
+  const original = f.agent.sessions[opened.sessionId].query;
+  const outcome = await f.rpc.request(METHOD, request(opened, fresh));
+  assert.equal(outcome.status, "acknowledged");
+  assert.equal(outcome.queryReceipt, opened._meta.intentCallbackRegistration.queryReceipt);
+  assert.equal(f.processes.length, 1);
+  assert.equal(f.processes[0].initializations, 1);
+  assert.equal(f.agent.sessions[opened.sessionId].query, original);
+  assert.deepEqual(outcome.result, { added: [outcome.serverName], removed: [], errors: {} });
+  const delivered = await f.processes[0].clients
+    .get(outcome.serverName)
+    .rpc.request("tools/call", { name: "probe", arguments: {} });
+  assert.equal(delivered.content[0].text, fresh.tag);
+  assert.deepEqual(
+    fresh.frames.map((x) => x.method),
+    ["initialize", "tools/list", "tools/call"],
+  );
+  const mutation = f.processes[0].frames.find(
+    (frame) => frame.request?.subtype === "mcp_set_servers",
+  );
+  assert.deepEqual(mutation.request.servers["workspace-mcp"].args, pending.config.args);
+  assert.deepEqual(mutation.request.servers.user.args, user.config.args);
+});
+
+function mutations(process) {
+  return process.frames.filter((frame) => frame.request?.subtype === "mcp_set_servers");
+}
+
+test("fixture permissions deny credential reads and any native child launch", () => {
+  assert.equal(process.env.NODE_OPTIONS, "");
+  assert.throws(() => readFileSync(`${homedir()}/.claude/settings.json`), {
+    code: "ERR_ACCESS_DENIED",
+  });
+  assert.throws(() => spawnSync(process.execPath, ["--version"]), { code: "ERR_ACCESS_DENIED" });
+});
+
+test("absent unsupported and malformed negotiation leave ordinary sessions unchanged", async (t) => {
+  for (const offered of [
+    undefined,
+    null,
+    false,
+    [],
+    "1",
+    { version: 2 },
+    { version: "1" },
+    { version: 1, extra: true },
+  ]) {
+    const capabilities =
+      offered === undefined ? {} : { _meta: { intentCallbackRegistration: offered } };
+    const f = await adapterFixture(t, capabilities);
+    assert.equal(f.init._meta.intentCallbackRegistration, undefined);
+    const opened = await f.newSession();
+    assert.equal(opened._meta, undefined);
+    const fresh = await peer(t, "unsupported route");
+    await assert.rejects(
+      f.rpc.request(METHOD, {
+        version: 1,
+        sessionId: opened.sessionId,
+        queryReceipt: "invented",
+        registrationId: "x",
+        server: fresh.config,
+      }),
+      /not negotiated/,
+    );
+    assert.equal(mutations(f.processes[0]).length, 0);
+    assert.equal(f.processes[0].initializations, 1);
+  }
+});
+
+test("malformed requests and invented receipts do not issue SDK mutation", async (t) => {
+  const f = await adapterFixture(t);
+  const opened = await f.newSession();
+  const fresh = await peer(t, "unused");
+  const valid = request(opened, fresh);
+  const invalid = [
+    null,
+    {},
+    { ...valid, version: 2 },
+    { ...valid, registrationId: "" },
+    { ...valid, queryReceipt: "different" },
+    { ...valid, extra: true },
+    { ...valid, server: { ...valid.server, env: { TOKEN: 1 } } },
+    { ...valid, server: { ...valid.server, name: "workspace-mcp" } },
+  ];
+  for (const params of invalid) await assert.rejects(f.rpc.request(METHOD, params));
+  assert.equal(mutations(f.processes[0]).length, 0);
+  const ok = await f.rpc.request(METHOD, valid);
+  assert.equal(ok.status, "acknowledged");
+  await assert.rejects(
+    f.rpc.request(METHOD, { ...valid, server: { ...valid.server, args: ["different"] } }),
+    /immutable/,
+  );
+  assert.equal(mutations(f.processes[0]).length, 1);
+});
+
+test("existing SDK/user entries and held old ordinary results survive new registration", async (t) => {
+  const pending = await peer(t, "old result");
+  const user = await peer(t, "SDK option user");
+  const fresh = await peer(t, "new result");
+  const f = await adapterFixture(t);
+  const opened = await f.newSession([["workspace-mcp", pending]], {
+    mcpServers: { user: user.config },
+  });
+  const originalClient = f.processes[0].clients.get("workspace-mcp");
+  const held = originalClient.rpc.request("tools/call", {
+    name: "probe",
+    arguments: { hold: true },
+  });
+  const call = await pending.callStarted.promise;
+  const added = await f.rpc.request(METHOD, request(opened, fresh));
+  assert.equal(added.status, "acknowledged");
+  assert.equal(f.processes[0].clients.get("workspace-mcp"), originalClient);
+  assert.equal(f.processes[0].clients.get("user").config.args[0], user.config.args[0]);
+  call.release.resolve();
+  assert.equal((await held).content[0].text, "old result");
+  assert.equal(
+    (await originalClient.rpc.request("tools/call", { name: "probe", arguments: {} })).content[0]
+      .text,
+    "old result",
+  );
+});
+
+test("per Query serialization retains all additions and snapshots queued request input", async (t) => {
+  const f = await adapterFixture(t);
+  const opened = await f.newSession();
+  const first = await peer(t, "first");
