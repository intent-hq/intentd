index 0000000..e6d164b
--- /dev/null
+++ b/tests/mcp-peer.mjs
@@ -0,0 +1,126 @@
+import { createServer, connect } from "node:net";
+import { createInterface } from "node:readline";
+
+export function deferred() {
+  let resolve;
+  const promise = new Promise((r) => {
+    resolve = r;
+  });
+  return { promise, resolve };
+}
+
+export class RpcLines {
+  constructor(input, output) {
+    this.output = output;
+    this.pending = new Map();
+    this.frames = [];
+    this.next = 1;
+    this.lines = createInterface({ input });
+    this.lines.on("line", (line) => {
+      const frame = JSON.parse(line);
+      this.frames.push(frame);
+      const pending = this.pending.get(frame.id);
+      if (pending) {
+        this.pending.delete(frame.id);
+        if (frame.error) pending.reject(Object.assign(new Error(frame.error.message), frame.error));
+        else pending.resolve(frame.result);
+      }
+    });
+    this.lines.on("close", () => {
+      for (const pending of this.pending.values()) pending.reject(new Error("fixture peer closed"));
+      this.pending.clear();
+    });
+  }
+  request(method, params = {}) {
+    const id = this.next++;
+    const response = new Promise((resolve, reject) => this.pending.set(id, { resolve, reject }));
+    this.output.write(`${JSON.stringify({ jsonrpc: "2.0", id, method, params })}\n`);
+    return response;
+  }
+  notify(method, params) {
+    this.output.write(`${JSON.stringify({ jsonrpc: "2.0", method, params })}\n`);
+  }
+  close() {
+    this.lines.close();
+    this.output.end();
+  }
+}
+
+// Real loopback MCP JSON-RPC exchange. No native provider, auth or repository grant.
+export async function mcpPeer(tag) {
+  const sockets = new Set();
+  const frames = [];
+  const calls = [];
+  const callStarted = deferred();
+  const server = createServer((socket) => {
+    sockets.add(socket);
+    socket.on("error", () => {});
+    socket.on("close", () => sockets.delete(socket));
+    const lines = createInterface({ input: socket });
+    lines.on("line", async (line) => {
+      const frame = JSON.parse(line);
+      frames.push(frame);
+      let result;
+      if (frame.method === "initialize")
+        result = {
+          protocolVersion: "2024-11-05",
+          capabilities: { tools: {} },
+          serverInfo: { name: tag, version: "1" },
+        };
+      else if (frame.method === "tools/list")
+        result = { tools: [{ name: "probe", description: tag, inputSchema: { type: "object" } }] };
+      else if (frame.method === "tools/call") {
+        const call = { params: frame.params, entered: deferred(), release: deferred() };
+        calls.push(call);
+        callStarted.resolve(call);
+        call.entered.resolve();
+        if (frame.params.arguments?.hold) await call.release.promise;
+        result = { content: [{ type: "text", text: tag }], isError: false };
+      } else return;
+      socket.write(`${JSON.stringify({ jsonrpc: "2.0", id: frame.id, result })}\n`);
+    });
+  });
+  await new Promise((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const address = server.address();
+  return {
+    tag,
+    frames,
+    calls,
+    callStarted,
+    config: { type: "stdio", command: "fixture-mcp", args: [`127.0.0.1:${address.port}`] },
+    async close() {
+      for (const call of calls) call.release.resolve();
+      for (const socket of sockets) socket.destroy();
+      await new Promise((resolve) => server.close(resolve));
+    },
+  };
+}
+
+export async function connectMcp(config) {
+  if (config.command !== "fixture-mcp" || config.type !== "stdio")
+    throw new Error("native executable prohibited in fixture");
+  const match = /^127\.0\.0\.1:(\d+)$/.exec(config.args[0]);
+  if (!match) throw new Error("non-loopback target prohibited in fixture");
+  const socket = connect(Number(match[1]), "127.0.0.1");
+  await new Promise((resolve, reject) => {
+    socket.once("connect", resolve);
+    socket.once("error", reject);
+  });
+  socket.on("error", () => {});
+  const rpc = new RpcLines(socket, socket);
+  await rpc.request("initialize", {
+    protocolVersion: "2024-11-05",
+    capabilities: {},
+    clientInfo: { name: "scripted-control-peer", version: "1" },
+  });
+  const tools = await rpc.request("tools/list");
+  return {
+    rpc,
+    tools,
+    config,
+    close() {
+      rpc.close();
+      socket.destroy();
+    },
+  };
+}
