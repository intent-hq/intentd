new file mode 100644
--- /dev/null
+++ b/src/review-monitoring-startup.ts
@@ -0,0 +1,93 @@
+import type { Options, Query } from '@anthropic-ai/claude-agent-sdk';
+import { ReviewAllocations, type ReviewStartupReservation } from './review-monitoring-allocations.js';
+import { ReviewMonitorJournal } from './review-monitoring-journal.js';
+import { ReviewProcessAllocation } from './review-monitoring-process.js';
+import { parseReviewContext, type ReviewContext } from './review-monitoring.js';
+
+function refuse(): never { throw new Error('Review monitoring startup unavailable'); }
+
+/** Internal original-allocation owner. The caller must establish negotiated
+ * context and, for load, freshly admit every prepared source before constructing
+ * this owner. It grants neither forge authority nor callback acknowledgement. */
+export class ReviewNativeStartup {
+  readonly context: ReviewContext;
+  readonly sessionId: string;
+  readonly #allocations: ReviewAllocations;
+  readonly #native: ReturnType<ReviewMonitorJournal['nativeDirectory']>;
+  readonly #environment: Readonly<Record<string,string | undefined>>;
+  readonly #current: () => void;
+  readonly #containmentExecutable: string;
+  #query?: Query;
+  #process?: ReviewProcessAllocation;
+  #closed=false;
+  #configured=false;
+  readonly #operations=new Set<Promise<unknown>>();
+  #forwarders?: {close:()=>void; join:()=>Promise<void>};
+  constructor(input: {
+    sessionId: string; context: ReviewContext; allocations: ReviewAllocations; reservation?: ReviewStartupReservation;
+    native: ReturnType<ReviewMonitorJournal['nativeDirectory']>;
+    environment: Readonly<Record<string,string | undefined>>;
+    containmentExecutable?: string;
+  }) {
+    this.context=parseReviewContext(input.context);this.sessionId=input.sessionId;
+    this.#allocations=input.allocations;this.#native=input.native;
+    this.#environment=Object.freeze({...input.environment});
+    this.#containmentExecutable=input.containmentExecutable ?? "/usr/bin/bwrap";
+    input.native.assertCurrent();
+    const register=input.reservation
+      ? (close:()=>void,join:()=>Promise<void>)=>input.reservation!.attach(close,join)
+      : (close:()=>void,join:()=>Promise<void>)=>input.allocations.register(input.sessionId,this.context,close,join);
+    this.#current=register(()=>{
+      this.#closed=true;
+      // Eligibility closes before any awaited cleanup, including SDK close.
+      // Always kill the exact native tree even if an owner callback throws.
+      try { this.#forwarders?.close(); }
+      finally { try { this.#query?.close(); } finally { if(this.#process)void this.#process.retire(); } }
+    },async()=>{
+      const outcomes=await Promise.allSettled([
+        this.#process?.retire() ?? Promise.resolve(),
+        this.#forwarders?.join() ?? Promise.resolve(),
+        ...this.#operations,
+      ]);
+      if(outcomes.some(result=>result.status==='rejected'))refuse();
+    });
+  }
+  assertCurrent(): void {
+    if(this.#closed)refuse();this.#current();this.#native.assertCurrent();
+    this.#process?.assertCurrent();
+  }
+  configure(options: Options): Options {
+    this.assertCurrent();if(this.#configured)refuse();this.#configured=true;
+    if(options.resume!==undefined && options.resume!==this.sessionId)refuse();
+    if(options.sessionId!==undefined && options.sessionId!==this.sessionId)refuse();
+    if(options.forkSession || options.sessionStore)refuse();
+    const cwd=options.cwd;if(!cwd)refuse();
+    return {...options, settingSources:[],
+      env:{...this.#environment,CLAUDE_CONFIG_DIR:'/run/intent-review/config',TMPDIR:'/run/intent-review/tmp'},
+      spawnClaudeCodeProcess:(spawnOptions)=>{
+        this.assertCurrent();if(this.#process)refuse();
+        const owned=new ReviewProcessAllocation(spawnOptions,[cwd],()=>this.assertCurrent(),this.#native.openForSpawn(),this.#containmentExecutable);
+        this.#process=owned;return owned.process;
+      },
+    };
+  }
+  bindQuery(query: Query): void {
+    this.assertCurrent();if(this.#query || !this.#process)refuse();this.#query=query;
+  }
+  bindForwarders(query: Query, close:()=>void, join:()=>Promise<void>): void {
+    this.assertCurrent();if(query!==this.#query || this.#forwarders)refuse();
+    this.#forwarders={close,join};
+  }
+  track<T>(operation:Promise<T>):Promise<T> {
+    this.assertCurrent();
+    // A retired operation rejects its own result; retirement joins settlement
+    // without turning expected refusal into a failed native-child join.
+    const settled=operation.then(()=>{},()=>{});
+    this.#operations.add(settled);
+    void settled.then(()=>this.#operations.delete(settled));
+    return operation;
+  }
+  retire(): Promise<{retired:true}> {
+    return this.#allocations.retire({sessionId:this.sessionId,loadAttemptId:this.context.loadAttemptId});
+  }
+}
