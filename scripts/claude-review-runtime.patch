+import assert from 'node:assert/strict';
+import {test} from 'node:test';
+import {mkdtempSync,readFileSync,existsSync,rmSync,openSync,closeSync,fstatSync,constants} from 'node:fs';
+import {tmpdir} from 'node:os';
+import {join} from 'node:path';
+import {once} from 'node:events';
+import {ReviewProcessAllocation} from '../dist/review-monitoring-process.js';
+
+// Real isolated processes, including a grandchild that escapes its parent's
+// process group. Controlled Node workload, not native Claude/SDK acceptance.
+const peer=`const {spawn}=require('child_process'),fs=require('fs');
+const code="const fs=require('fs');fs.appendFileSync(process.argv[1],'x');console.log('ready');setInterval(()=>{fs.appendFileSync(process.argv[1],'x');console.log('tick')},10)";
+const child=spawn(process.execPath,['-e',code,process.argv[1]],{detached:true,stdio:['ignore','inherit','ignore']});
+child.unref();
+setInterval(()=>{},1000);`;
+
+test('retiring one namespace joins escaped descendants and preserves an independent allocation',{timeout:15000},async t=>{
+ const root=mkdtempSync(join(tmpdir(),'intent-review-process-'));
+ const allocations=[];
+ t.after(async()=>{for(const a of allocations)await a.retire();rmSync(root,{recursive:true,force:true});});
+ for(const name of ['original','sibling']){
+  const a=new ReviewProcessAllocation({command:process.execPath,args:['-e',peer,join(root,name)],cwd:root,env:{PATH:process.env.PATH,NODE_OPTIONS:''}},[root],()=>{});
+  allocations.push(a);
+  let error='';a.process.stderr.on('data',chunk=>{error+=chunk});
+  const [ready]=await once(a.process.stdout,'data');assert.match(String(ready),/ready/,error);
+ }
+ const [original,sibling]=allocations;
+ assert.ok(readFileSync(join(root,'original')).length>0);
+ const retired=original.retire();
+ assert.throws(()=>original.assertCurrent(),/unavailable/);
+ sibling.assertCurrent();
+ await retired;
+ const stopped=readFileSync(join(root,'original')).length;
+ const continuing=readFileSync(join(root,'sibling')).length;
+ // A real write by the unaffected sibling is the observation barrier.
+ await once(sibling.process.stdout,'data');
+ assert.equal(readFileSync(join(root,'original')).length,stopped,'no escaped descendant write after completed join');
+ assert.ok(readFileSync(join(root,'sibling')).length>continuing,'unrelated allocation remains live');
+ await original.retire();await sibling.retire();
+});
+
+for (const reason of ['retired-source','wrong-config']) {
+ test(`startup refusal closes transferred native descriptor: ${reason}`,()=>{
+  const root=mkdtempSync(join(tmpdir(),'intent-review-descriptor-'));
+  const fd=openSync(root,constants.O_RDONLY|constants.O_DIRECTORY);
+  try {
+   assert.throws(()=>new ReviewProcessAllocation({command:process.execPath,args:[],cwd:root,
+    env:{CLAUDE_CONFIG_DIR:reason==='wrong-config'?'/wrong':'/run/intent-review/config'}},[],
+    ()=>{if(reason==='retired-source')throw new Error('retired source')},fd));
+   assert.throws(()=>fstatSync(fd),{code:'EBADF'},'ownership closes even before spawn');
+  } finally {try{closeSync(fd)}catch{}rmSync(root,{recursive:true,force:true});}
+ });
+}
+
+
+test('private temporary directory is writable and distinct for each native allocation',{timeout:15000},async t=>{
+ const root=mkdtempSync(join(tmpdir(),'intent-review-private-temp-'));
+ const allocations=[];
+ t.after(async()=>{for(const allocation of allocations)await allocation.retire();rmSync(root,{recursive:true,force:true});});
+ for(const name of ['original','sibling']){
+  const fd=openSync(root,constants.O_RDONLY|constants.O_DIRECTORY);
+  const code="const fs=require('fs'),p=require('path').join(process.env.TMPDIR,'owned');if(fs.existsSync(p))process.exit(2);fs.writeFileSync(p,process.argv[1]);console.log(fs.readFileSync(p,'utf8'));setInterval(()=>{},1000)";
+  const allocation=new ReviewProcessAllocation({command:process.execPath,args:['-e',code,name],cwd:root,
+   env:{PATH:process.env.PATH,NODE_OPTIONS:'',CLAUDE_CONFIG_DIR:'/run/intent-review/config',TMPDIR:'/run/intent-review/tmp'}},[],()=>{},fd);
+  allocations.push(allocation);
+  let error='';allocation.process.stderr.on('data',chunk=>{error+=chunk});
+  const [ready]=await once(allocation.process.stdout,'data');assert.equal(String(ready).trim(),name,error);
+ }
+ await allocations[0].retire();allocations[1].assertCurrent();
+ assert.equal(existsSync(join(root,'owned')),false,'ephemeral file must not be written into the held journal directory');
+});
