+      return ledger;
+    } catch { return refuse(); }
+  }
+  #current(): void {
+    if (this.#closed) refuse();
+    safeFile(join(this.#root,"owner.sqlite"));
+    if(this.#identity("owner.sqlite")!==this.#lockIdentity) refuse();
+    safeFile(join(this.#root,"key"));safeFile(join(this.#root,"ledger"));
+    // Includes replacement/deletion/recreation and other owner writes. No reload
+    // by public session ID can silently adopt a concurrent/replaced installation.
+    if(this.#rootIdentity()!==this.#ledger.rootIdentity || this.#identity("ledger")!==this.#ledgerIdentity || this.#identity("key")!==this.#keyIdentity || !readFileSync(join(this.#root,"key")).equals(this.#key) || readFileSync(join(this.#root,"ledger"),"utf8")!==this.#wire) refuse();
+  }
+  #write(next: Ledger): void {
+    this.#current();
+    next.generation++;
+    const wire=this.#encode(next);
+    atomic(this.#root,"ledger",wire);
+    this.#ledger=next;this.#wire=wire;this.#ledgerIdentity=this.#identity("ledger");
+  }
+  #family(sessionId: string, ownerKey: string): Family {
+    this.#current();
+    const family=this.#ledger.families[sessionId];
+    if(!family || family.ownerKey!==ownerKey || family.sessionId!==sessionId || !Array.isArray(family.entries)) refuse();
+    for (const entry of family.entries) {
+      const accepted=parseMonitorPrompt(entry.acceptedPrompt);
+      if (!accepted || entry.nativeFramingVersion!==1 || entry.nativeText!==formatReviewMonitorObservation(accepted.text)) refuse();
+      if (typeof entry.sdkUuid!=="string" || !/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/.test(entry.sdkUuid)) refuse();
+    }
+    return family;
+  }
+  #sources(sessionId: string, ownerKey: string): Entry[] {
+    const sources=new Map<string,Entry>(),visiting=new Set<string>(),visited=new Set<string>();
+    const visit=(id: string) => {
+      if(visiting.has(id)) refuse();
+      if(visited.has(id)) return;
+      const family=this.#family(id,ownerKey);
+      if(!Array.isArray(family.parents)) refuse();
+      visiting.add(id);
+      for(const parent of family.parents) visit(parent);
+      for(const entry of family.entries) {
+        const prior=sources.get(entry.messageId);
+        if(prior && JSON.stringify(prior)!==JSON.stringify(entry)) refuse();
+        sources.set(entry.messageId,entry);
+      }
+      visiting.delete(id);visited.add(id);
+    };
+    visit(sessionId);
+    return [...sources.values()];
+  }
+  /** Allocate a NEW native session ID, never enroll an imported/caller ID. The
+   * native creator must consume this ID before any Query/context creation. */
+  enroll(ownerKey: string, parents: readonly string[] = []): string {
+    this.#current();
+    if(!ownerKey || Buffer.byteLength(ownerKey)>256 || !ownerKey.isWellFormed()) refuse();
+    const sources=new Map<string,Entry>();
+    for(const parent of parents) {
+      for(const entry of this.#sources(parent,ownerKey)) {
+        const prior=sources.get(entry.messageId);
+        if(prior && JSON.stringify(prior)!==JSON.stringify(entry)) refuse();
+        sources.set(entry.messageId,structuredClone(entry));
+      }
+    }
+    const sessionId=randomUUID();
+    const next=structuredClone(this.#ledger);
+    next.families[sessionId]={ownerKey,sessionId,parents:[...parents],entries:[...sources.values()]};
+    this.#write(next);return sessionId;
+  }
+  /** Allocate an empty native config/transcript directory only for a newly
+   * minted enrollment. The immutable directory identity lives in the signed
+   * private ledger, outside that native tree. Crash between enrollment and
+   * association leaves an unusable family, never a proven ordinary resume. */
+  enrollNative(ownerKey: string, parents: readonly string[] = []): string {
+    const sessionId=this.enroll(ownerKey,parents);
+    const root=join(this.#root,`native-${sessionId}`);
+    mkdirSync(root,{mode:0o700});
+    const stat=lstatSync(root,{bigint:true});
+    if(!stat.isDirectory() || stat.isSymbolicLink() || (stat.mode&0o077n)!==0n)refuse();
+    syncDirectory(root);syncDirectory(this.#root);
+    const next=structuredClone(this.#ledger);
+    next.families[sessionId].nativeDirectory={name:basename(root),device:String(stat.dev),inode:String(stat.ino)};
+    this.#write(next);
+    return sessionId;
+  }
+  /** Original local namespace only. This association constrains a freshly
+   * admitted startup; it is neither forge authority nor a delivery receipt.
+   * Missing/imported/byte-identical replacement directories cannot be adopted.
+   * Retain assertCurrent through held capture and use the verified FD at spawn. */
+  nativeDirectory(sessionId: string, ownerKey: string) {
+    const expected=this.#family(sessionId,ownerKey).nativeDirectory;
+    if(!expected || typeof expected.name!=="string" || !/^(native-[0-9a-f-]{36}|review-resume-[a-zA-Z0-9]+)$/.test(expected.name) || !/^[0-9]+$/.test(expected.device) || !/^[0-9]+$/.test(expected.inode))refuse();
+    const root=join(this.#root,expected.name);
+    const matches=(stat:BigIntStats)=>stat.isDirectory() &&
+      (stat.mode&0o077n)===0n && String(stat.dev)===expected.device && String(stat.ino)===expected.inode;
+    const assertCurrent=()=>{
+      const now=this.#family(sessionId,ownerKey).nativeDirectory;
+      if(!now || now.name!==expected.name || now.device!==expected.device || now.inode!==expected.inode)refuse();
+      const stat=lstatSync(root,{bigint:true});
+      if(stat.isSymbolicLink() || !matches(stat))refuse();
+    };
+    assertCurrent();
+    return Object.freeze({root,assertCurrent,openForSpawn:()=>{
+      assertCurrent();
+      const fd=openSync(root,constants.O_RDONLY|constants.O_DIRECTORY|constants.O_NOFOLLOW);
+      try{if(!matches(fstatSync(fd,{bigint:true})))refuse();assertCurrent();return fd;}
+      catch(error){closeSync(fd);throw error;}
+    }});
+  }
+  /** Persist complete exact input + native UUID BEFORE any SDK input/queue use.
+   * Retry returns the original mapping, not permission to feed it again. */
+  /** Retain the exact private source union across asynchronous preparation.
+   * Any mutation invalidates this guard; this is not fresh forge authority. */
+  captureCurrent(): () => void {
+    this.#current();const generation=this.#ledger.generation;
+    return ()=>{this.#current();if(this.#ledger.generation!==generation)refuse();};
+  }
+  /** After one-use prepare consumption and independent admission, publish the
+   * held complete namespace as the original family's next native allocation.
+   * Caller must already have joined the former writer and fence new dispatch.
+   * Old namespace bytes are retained, never rebound or used as a fallback. */
+  adoptNativeSnapshot(sessionId: string, ownerKey: string, snapshot: HeldReviewNamespace, preparedCurrent: () => void) {
+    const original=this.nativeDirectory(sessionId,ownerKey);
+    preparedCurrent();original.assertCurrent();
+    const held=snapshot.materialize(this.#root);
+    try {
+      preparedCurrent();original.assertCurrent();
+      const root=held.persist();
+      if(dirname(root)!==this.#root)refuse();
+      const stat=lstatSync(root,{bigint:true});
+      if(!stat.isDirectory() || stat.isSymbolicLink() || (stat.mode&0o077n)!==0n)refuse();
+      preparedCurrent();original.assertCurrent();
+      const next=structuredClone(this.#ledger);
+      next.families[sessionId].nativeDirectory={name:basename(root),device:String(stat.dev),inode:String(stat.ino)};
+      this.#write(next);
+      return this.nativeDirectory(sessionId,ownerKey);
+    } finally { held.dispose(); }
+  }
+  recordBeforeFeed(sessionId: string, ownerKey: string, acceptedPrompt: unknown): ReturnType<typeof randomUUID> {
+    const family=this.#family(sessionId,ownerKey);
+    const message=parseMonitorPrompt(acceptedPrompt);
+    if(!message || message.sessionId!==sessionId) refuse();
+    const old=this.#sources(sessionId,ownerKey).find(entry=>entry.messageId===message.messageId);
+    if(old) {
+      if(old.storeEnvelopeDigest!==message.storeEnvelopeDigest || old.acpPayloadDigest!==message.acpPayloadDigest || JSON.stringify(old.acceptedPrompt)!==JSON.stringify(acceptedPrompt)) refuse();
+      return old.sdkUuid;
+    }
+    const next=structuredClone(this.#ledger);
+    const sdkUuid=randomUUID();
+    next.families[sessionId].entries.push({messageId:message.messageId,storeEnvelopeDigest:message.storeEnvelopeDigest,acpPayloadDigest:message.acpPayloadDigest,sdkUuid,acceptedPrompt:structuredClone(acceptedPrompt),nativeFramingVersion:1,nativeText:formatReviewMonitorObservation(message.text)});
+    this.#write(next);return sdkUuid;
+  }
+  /** One locally consumable input. The runtime must additionally retain fresh
+   * all-source/session eligibility through feed; the token is not that authority.
+   * Existing/uncertain journal entries never mint an automatic retry token. */
+  prepareInput(sessionId: string, ownerKey: string, acceptedPrompt: unknown): ReviewJournalInput {
+    const family=this.#family(sessionId,ownerKey);
+    const message=parseMonitorPrompt(acceptedPrompt);
+    if (!message || this.#sources(sessionId,ownerKey).some(entry=>entry.messageId===message.messageId)) refuse();
+    const sdkUuid=this.recordBeforeFeed(sessionId,ownerKey,acceptedPrompt);
+    const token=Object.freeze({}) as ReviewJournalInput;
+    const generation=this.#ledger.generation;
+    inputs.set(token,{prompt:structuredClone(acceptedPrompt),sdkUuid,nativeText:formatReviewMonitorObservation(message.text),current:()=>{
+      this.#family(sessionId,ownerKey);
+      if(this.#ledger.generation!==generation) refuse();
+    }});
+    return token;
+  }
+  /** Recover classification only from the original durable pre-feed mapping.
+   * Native CLI persistence does not retain SDK origin in this pinned runtime.
+   * An unmatched row is NOT authorization to replay it: the caller must first
+   * admit the complete enrolled family and held native closure. A matching UUID
+   * with changed content is corruption, never an ordinary-message fallback. */
+  classifyNativeMessage(sessionId: string, ownerKey: string, row: unknown) {
+    const sources=this.#sources(sessionId,ownerKey);
+    if(!row || typeof row!=="object" || Array.isArray(row))refuse();
+    const value=row as Record<string,unknown>;
+    const entry=sources.find(source=>source.sdkUuid===value.uuid);
+    if(!entry)return undefined;
+    const original=parseMonitorPrompt(entry.acceptedPrompt);
+    if(!original || value.type!=="user" || value.sessionId!==original.sessionId)refuse();
+    const message=value.message as Record<string,unknown>|undefined;
+    if(!message || message.role!=="user" || !Array.isArray(message.content) || message.content.length!==1)refuse();
+    const text=message.content[0];
+    if(!text || typeof text!=="object" || Array.isArray(text) || Object.keys(text).length!==2 ||
+      text.type!=="text" || text.text!==entry.nativeText)refuse();
+    // Return correlations only. Never export the private original binding or
+    // confuse this classification with current account/recipient authority.
+    return Object.freeze({messageId:entry.messageId,storeEnvelopeDigest:entry.storeEnvelopeDigest,
+      acpPayloadDigest:entry.acpPayloadDigest,sdkUuid:entry.sdkUuid,origin:Object.freeze({kind:"task-notification" as const})});
+  }
+  /** The supplied closure must be captured by the actual native input owner and
+   * consumed immutably. This journal cannot prove a caller supplied all files. */
+  snapshot(sessionId: string, ownerKey: string, closure: Readonly<Record<string,string>>) {
+    const family=this.#family(sessionId,ownerKey);
+    const held=Object.freeze(Object.fromEntries(Object.entries(closure).sort(([a],[b])=>a<b ? -1 : a>b ? 1 : 0)));
+    const complete=this.#sources(sessionId,ownerKey);
+    const sources=complete.map(({messageId,storeEnvelopeDigest,acpPayloadDigest})=>Object.freeze({messageId,storeEnvelopeDigest,acpPayloadDigest}));
+    return Object.freeze({closure:held,monitorMessages:Object.freeze(sources),snapshotDigest:sha(JSON.stringify([
+      "intent-review-monitor-history-v1",this.#ledger.installation,this.#ledger.generation,
+      sessionId,ownerKey,family.parents,complete,held,
+    ]))});
+  }
+}
diff --git a/src/review-monitoring-transcripts.ts b/src/review-monitoring-transcripts.ts
new file mode 100644
--- /dev/null
+++ b/src/review-monitoring-transcripts.ts
@@ -0,0 +1,81 @@
+import { createHash } from "node:crypto";
+import type { SessionKey, SessionStore, SessionStoreEntry } from "@anthropic-ai/claude-agent-sdk";
+
+function refuse(): never { throw new Error("Review monitoring history unavailable"); }
+function json(value: unknown): void {
+  if (value === null || typeof value === "boolean" || typeof value === "string") return;
+  if (typeof value === "number" && Number.isFinite(value)) return;
+  if (Array.isArray(value)) { for (const item of value) json(item); return; }
+  if (typeof value === "object" && value !== null && Object.getPrototypeOf(value) === Object.prototype) {
+    for (const item of Object.values(value)) json(item);
+    return;
+  }
+  refuse();
+}
+function entries(value: unknown): string {
+  if (!Array.isArray(value) || value.length === 0) refuse();
+  for (const entry of value) {
+    if (!entry || typeof entry !== "object" || typeof entry.type !== "string" || entry.type.length === 0) refuse();
+  }
+  try { json(value); return JSON.stringify(value); } catch { return refuse(); }
+}
+
+/** Immutable transcript component of a held history closure. This is NOT an
+ * authority or complete native namespace: enrollment, configurations, original
+ * admission and final spawn/retirement must be supplied by the owning runtime.
+ * It prevents the SDK's null/empty/unsafe-subpath fallback. Mirror writes are
+ * intentionally unavailable; SDK mirror completion is never a delivery fence.
+ */
+export class HeldReviewTranscripts {
+  readonly sessionId: string;
+  readonly componentDigest: string;
+  readonly #projectKey: string;
+  readonly #rows: Map<string, string>;
+  readonly #current: () => void;
+  #retired = false;
+  readonly store: SessionStore;
+
+  constructor(input: {
+    sessionId: string;
+    projectKey: string;
+    main: unknown;
+    children: readonly { subpath: string; entries: unknown }[];
+  }, current: () => void) {
+    if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(input.sessionId)) refuse();
+    if (!/^[a-zA-Z0-9_-]{1,256}$/.test(input.projectKey)) refuse();
+    this.sessionId=input.sessionId;
+    this.#projectKey=input.projectKey;
+    this.#current=current;
+    this.#rows=new Map([["",entries(input.main)]]);
+    for (const child of input.children) {
+      if (typeof child.subpath !== "string" || child.subpath.length > 1024 ||
+          !child.subpath.split("/").every(part=>/^[a-zA-Z0-9_.-]+$/.test(part) && part!=="." && part!=="..") ||
+          this.#rows.has(child.subpath)) refuse();
+      this.#rows.set(child.subpath,entries(child.entries));
+    }
+    this.componentDigest=createHash("sha256").update(JSON.stringify([
+      "intent-review-held-transcripts-v1",this.sessionId,this.#projectKey,[...this.#rows].sort(([a],[b])=>a<b?-1:a>b?1:0),
+    ])).digest("hex");
+    this.store=Object.freeze({
+      load: async (key: SessionKey): Promise<SessionStoreEntry[]> => {
+        this.#check(key);
+        if (key.subpath === "") refuse();
+        const encoded=this.#rows.get(key.subpath ?? "");
+        if (encoded === undefined) refuse();
+        return JSON.parse(encoded);
+      },
+      listSubkeys: async (key: {projectKey: string;sessionId: string}) => {
+        this.#check(key);
+        return [...this.#rows.keys()].filter(key=>key!=="").sort();
+      },
+      append: async () => refuse(),
+    });
+    this.#check({projectKey:this.#projectKey,sessionId:this.sessionId});
+  }
+  assertCurrent(): void { this.#check({projectKey:this.#projectKey,sessionId:this.sessionId}); }
+  retire(): void { this.#retired=true; }
+  #check(key: {projectKey: string;sessionId: string}): void {
+    if (this.#retired || key.projectKey!==this.#projectKey || key.sessionId!==this.sessionId) refuse();
+    this.#current();
+  }
+}
diff --git a/src/tests/review-monitoring-turn.test.ts b/src/tests/review-monitoring-turn.test.ts
new file mode 100644
--- /dev/null
+++ b/src/tests/review-monitoring-turn.test.ts
@@ -0,0 +1,78 @@
+import {it,expect,vi} from "vitest";
+import {mkdtempSync,rmSync} from "node:fs";
+import {tmpdir} from "node:os";
+import {join} from "node:path";
+import {ClaudeAcpAgent,type AcpClient} from "../acp-agent.js";
+import {Pushable} from "../utils.js";
+import {ReviewMonitorJournal} from "../review-monitoring-journal.js";
+import {monitorPayloadDigest} from "../review-monitoring.js";
+import {mockSessionState,wrapQuery,successfulResultMessage} from "./session-doubles.js";
+
+// Actual adapter turn consumer; SDK output/model are controlled here. Separate
+// subprocess tests cover SDK serialization, not end-to-end native admission.
+for(const mode of ["matching","unrelated","missing-uuid","cancelled"]){
+ it(`settles journal-classified monitor turn only for its original UUID: ${mode}`,async()=>{
+  const root=mkdtempSync(join(tmpdir(),"intent-review-turn-"));
+  const journal=new ReviewMonitorJournal(join(root,"private"),true);
+  const sessionId=journal.enroll("owner"),text="private monitor text",messageId="message",storeEnvelopeDigest="a".repeat(64);
+  const params={sessionId,prompt:[{type:"text" as const,text}],_meta:{reviewMonitoringMessage:{version:1,messageId,storeEnvelopeDigest,acpPayloadDigest:monitorPayloadDigest(sessionId,messageId,storeEnvelopeDigest,text)}}};
+  const token=journal.prepareInput(sessionId,"owner",params);
+  const input=new Pushable<any>();
+  const agent=new ClaudeAcpAgent({sessionUpdate:async()=>{}} as unknown as AcpClient,{log(){},error(){}});
+  (agent as any).probeCliAuthStatus=async()=>undefined;
+  (agent as any).runClaudeSubscriptionGuard=()=>undefined;
+  let observed:any;
+  async function* output(){
+   const {value}=await input[Symbol.asyncIterator]().next(); observed=value;
+   yield {type:"user",message:value.message,uuid:value.uuid,session_id:sessionId,parent_tool_use_id:null,isReplay:true};
+   if(mode==="unrelated"){
+    yield successfulResultMessage({origin:{kind:"task-notification"},user_message_uuid:"unrelated",stop_reason:"end_turn"});
+   }
+   if(mode==="missing-uuid") yield successfulResultMessage({origin:{kind:"task-notification"},user_message_uuid:undefined,stop_reason:"end_turn"});
+   if(mode==="cancelled") agent.sessions[sessionId].cancelled=true;
+   yield successfulResultMessage({origin:{kind:"task-notification"},user_message_uuid:value.uuid,session_id:sessionId,stop_reason:"max_tokens"});
+   yield {type:"system",subtype:"session_state_changed",state:"idle"};
+  }
+  agent.sessions[sessionId]=mockSessionState({query:wrapQuery(output()),input,cwd:root},agent,sessionId);
+  const title=vi.spyOn(agent.sessions[sessionId].titles,"onPrompt");
+  const goal=vi.spyOn(agent as any,"publishGoalFromPrompt");
+  try{
+   const response=await agent.prompt(params,token);
+   expect(title).not.toHaveBeenCalled();
+   expect(goal).not.toHaveBeenCalled();
+   expect(observed.origin.kind).toBe("task-notification");
+   expect(observed.uuid).toBe(journal.recordBeforeFeed(sessionId,"owner",params));
+   expect(response.stopReason).toBe(mode==="cancelled"?"cancelled":"max_tokens");
+  }finally{
+   input.end();agent.sessions[sessionId].query.close();journal.close();rmSync(root,{recursive:true,force:true});
+  }
+ },10000);
+}
+
+for (const mode of ["session", "query"]) {
+ it(`refuses a monitor token after original ${mode} replacement during provider update`,async()=>{
+  const root=mkdtempSync(join(tmpdir(),"intent-review-replaced-"));
+  const journal=new ReviewMonitorJournal(join(root,"private"),true);
+  const sessionId=journal.enroll("owner"),text="private",messageId="message",storeEnvelopeDigest="a".repeat(64);
+  const params={sessionId,prompt:[{type:"text" as const,text}],_meta:{reviewMonitoringMessage:{version:1,messageId,storeEnvelopeDigest,acpPayloadDigest:monitorPayloadDigest(sessionId,messageId,storeEnvelopeDigest,text)}}};
+  const token=journal.prepareInput(sessionId,"owner",params);
+  const agent=new ClaudeAcpAgent({sessionUpdate:async()=>{}} as unknown as AcpClient,{log(){},error(){}});
+  (agent as any).probeCliAuthStatus=async()=>undefined;
+  (agent as any).runClaudeSubscriptionGuard=()=>undefined;
+  const input=new Pushable<any>();
+  const push=vi.spyOn(input,"push");
+  async function* output(){}
+  const original=mockSessionState({query:wrapQuery(output()),input,cwd:root},agent,sessionId);
+  agent.sessions[sessionId]=original;
+  let release!:()=>void;
+  (agent as any).providerUpdate=new Promise<void>(resolve=>{release=resolve;});
+  try{
+   const result=agent.prompt(params,token);
+   if(mode==="session") agent.sessions[sessionId]=mockSessionState({query:wrapQuery(output()),input,cwd:root},agent,sessionId);
+   else original.query=wrapQuery(output());
+   release();
+   await expect(result).rejects.toThrow("Review monitoring history unavailable");
+   expect(push).not.toHaveBeenCalled();
+  }finally{release();input.end();journal.close();rmSync(root,{recursive:true,force:true});}
+ });
+}
