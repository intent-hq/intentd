+import assert from 'node:assert/strict';
+import {test} from 'node:test';
+import {ReviewAllocations} from '../dist/review-monitoring-allocations.js';
+const context=id=>({version:1,ownerKey:'original-owner',loadAttemptId:id});
+function deferred(){let resolve,reject;const promise=new Promise((a,b)=>{resolve=a;reject=b});return {promise,resolve,reject};}
+test('exact attempt closes eligibility synchronously and acknowledges only joined retirement',async()=>{
+ const registry=new ReviewAllocations(),gate=deferred();let closed=false,joins=0;
+ const current=registry.register('session',context('original'),()=>{closed=true},()=>{joins++;return gate.promise});
+ current();assert.throws(()=>registry.retire({sessionId:'session',loadAttemptId:'unknown'}));
+ const result=registry.retire({sessionId:'session',loadAttemptId:'original'});
+ assert.equal(closed,true);assert.throws(current);assert.equal(joins,1);
+ assert.equal(registry.retire({sessionId:'session',loadAttemptId:'original'}),result);
+ let done=false;result.then(()=>{done=true});await Promise.resolve();assert.equal(done,false);
+ const replacement=registry.register('session',context('replacement'),()=>{},async()=>{});
+ gate.resolve();assert.deepEqual(await result,{retired:true});replacement();
+ await registry.retire({sessionId:'session',loadAttemptId:'original'});replacement();
+ assert.throws(()=>registry.register('session',context('original'),()=>{},async()=>{}));
+ await registry.close();assert.throws(replacement);
+});
+test('connection retirement fences all allocations before awaiting joins and retains join failures',async()=>{
+ const registry=new ReviewAllocations(),gate=deferred(),order=[];
+ registry.register('a',context('a'),()=>{order.push('a')},()=>gate.promise);
+ const sibling=registry.register('b',context('b'),()=>{order.push('b')},async()=>{});
+ const closed=registry.close();assert.deepEqual(order,['a','b']);assert.throws(sibling);
+ assert.throws(()=>registry.register('new',context('new'),()=>{},async()=>{}));
+ gate.reject(new Error('private failure details'));await assert.rejects(closed,/unavailable/);
+ await assert.rejects(registry.retire({sessionId:'a',loadAttemptId:'a'}),error=>error.message==='Review monitoring allocation unavailable');
+});
+test('malformed selectors never downgrade to current session retirement',async()=>{
+ const registry=new ReviewAllocations();let closed=0;
+ const current=registry.register('session',context('original'),()=>{closed++},async()=>{});
+ for(const value of [{sessionId:'session'}, {sessionId:'session',loadAttemptId:'original',extra:true},null,{sessionId:'session',loadAttemptId:''}])assert.throws(()=>registry.retire(value));
+ current();assert.equal(closed,0);await registry.close();
+});
+test('eligibility callback failure still joins the owned allocation and never acknowledges success',async()=>{
+ const registry=new ReviewAllocations(),gate=deferred();let joining=false;
+ registry.register('session',context('attempt'),()=>{throw new Error('failure')},()=>{joining=true;return gate.promise});
