+import assert from 'node:assert/strict';
+import {test} from 'node:test';
+import {mkdtempSync,rmSync,writeFileSync} from 'node:fs';
+import {tmpdir} from 'node:os';
+import {join} from 'node:path';
+import {PassThrough,Readable,Writable} from 'node:stream';
+import {ndJsonStream} from '@agentclientprotocol/sdk';
+import {runAcp} from '../dist/acp-agent.js';
+import {ReviewMonitorJournal} from '../dist/review-monitoring-journal.js';
+import {RpcLines} from './mcp-peer.mjs';
+
+for (const kind of ['missing','unusable']) test(`private capability refuses ${kind} containment before advertisement`,async()=>{
+ const root=mkdtempSync(join(tmpdir(),'intent-review-availability-'));
+ const executable=join(root,'containment');
+ if(kind==='unusable')writeFileSync(executable,'#!/bin/sh\nexit 1\n',{mode:0o700});
+ const journal=new ReviewMonitorJournal(join(root,'journal'),true);
+ const input=new PassThrough(),output=new PassThrough();
+ const {agent,connection}=runAcp({log(){},error(){},warn(){},debug(){}},ndJsonStream(Writable.toWeb(output),Readable.toWeb(input)),
+   {journal,environment:{PATH:process.env.PATH},containmentExecutable:executable});
+ agent.probeCliAuthStatus=async()=>{};
+ const rpc=new RpcLines(output,input);
+ try {
+  await assert.rejects(rpc.request('initialize',{protocolVersion:1,clientCapabilities:{_meta:{reviewMonitoring:1,intentCallbackRegistration:{version:1}}}}),
+    'unavailable containment cannot advertise private support');
+  await assert.rejects(rpc.request('session/new',{cwd:root,mcpServers:[],_meta:{reviewMonitoringContext:{version:1,ownerKey:'owner',loadAttemptId:'attempt'}}}));
+  const ordinary=await rpc.request('initialize',{protocolVersion:1,clientCapabilities:{}});
+  assert.equal(ordinary._meta?.reviewMonitoring,undefined,'ordinary initialization remains available');
+ } finally {await agent.dispose();rpc.close();connection.close();input.end();output.end();journal.close();rmSync(root,{recursive:true,force:true});}
+});
