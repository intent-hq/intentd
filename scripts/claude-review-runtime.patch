+    if (this.#closed) return;
+    this.#closed=true;
+    this.#lock.close();
+  }
+  #rootIdentity(): string {
+    const stat=lstatSync(this.#root);
+    return `${stat.dev}:${stat.ino}`;
+  }
+  #identity(name: string): string {
+    const stat=lstatSync(join(this.#root,name));
+    return `${stat.dev}:${stat.ino}`;
+  }
+  #encode(ledger: Ledger): string {
+    const payload=JSON.stringify(ledger);
