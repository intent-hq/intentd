new file mode 100644
--- /dev/null
+++ b/src/review-monitoring-namespace.ts
@@ -0,0 +1,144 @@
+import { createHash } from "node:crypto";
+import { constants, closeSync, fstatSync, fsyncSync, mkdirSync, mkdtempSync, openSync, readFileSync, realpathSync, readdirSync, rmSync, writeFileSync, type BigIntStats } from "node:fs";
+import { isAbsolute, join } from "node:path";
+
+function refuse(): never { throw new Error("Review monitoring history unavailable"); }
+type Entry = Readonly<{name: string; directory: boolean; bytes: string}>;
+function identity(stat: BigIntStats): string {
+  return [stat.dev,stat.ino,stat.mode,stat.size,stat.mtimeNs,stat.ctimeNs,stat.nlink].join(":");
+}
+function digest(entries: readonly Entry[]): string {
+  return createHash("sha256").update(JSON.stringify(["intent-review-native-tree-v1",entries])).digest("hex");
+}
+
+/** Linux descriptor-relative capture of an owned private native input tree.
+ * The runtime must first quiesce its original allocation, supply every namespace
+ * input, and bind this component into the admitted journal snapshot. This class
+ * cannot infer account authority, lineage completeness or process containment.
+ * Unsupported hosts refuse; no path-based traversal fallback is permitted.
+ */
+export class HeldReviewNamespace {
+  readonly componentDigest: string;
+  readonly #entries: readonly Entry[];
+  readonly #current: () => void;
+  private constructor(entries: Entry[], current: () => void) {
+    this.#entries=Object.freeze(entries.map(entry=>Object.freeze(entry)));
+    this.componentDigest=digest(this.#entries);
+    this.#current=current;
+  }
+  static capture(root: string, current: () => void): HeldReviewNamespace {
+    if(process.platform!=="linux" || !isAbsolute(root)) refuse();
+    current();
+    const opened: {fd:number; identity:string}[]=[];
+    const entries: Entry[]=[];
+    let bytes=0;
+    const open=(path: string,directory: boolean): number=>{
+      const fd=openSync(path,constants.O_RDONLY|constants.O_NOFOLLOW|(directory?constants.O_DIRECTORY:constants.O_NONBLOCK));
+      const stat=fstatSync(fd,{bigint:true});
+      opened.push({fd,identity:identity(stat)});
+      if(directory?!stat.isDirectory():!stat.isFile() || stat.nlink!==1n) refuse();
+      return fd;
+    };
+    try{
+      const rootFd=open(root,true);
+      if((fstatSync(rootFd).mode&0o077)!==0) refuse();
+      const walk=(fd:number,prefix:string)=>{
+        current();
+        const source=`/proc/self/fd/${fd}`;
+        for(const child of readdirSync(source,{withFileTypes:true}).sort((a,b)=>a.name<b.name?-1:a.name>b.name?1:0)){
+          if(entries.length>=4096 || child.name.includes("\\") || !child.name.isWellFormed() || child.isSymbolicLink()) refuse();
+          const name=prefix+child.name;
+          if(child.isDirectory()){
+            const next=open(join(source,child.name),true);
+            entries.push({name,directory:true,bytes:""});walk(next,name+"/");
+          }else{
+            if(!child.isFile()) refuse();
+            const file=open(join(source,child.name),false);
+            const size=fstatSync(file,{bigint:true}).size;
+            if(size>64n*1024n*1024n || bytes+Number(size)>64*1024*1024) refuse();
+            const content=readFileSync(file);bytes+=content.length;
+            if(content.length!==Number(size) || bytes>64*1024*1024) refuse();
+            entries.push({name,directory:false,bytes:content.toString("base64")});
+          }
+        }
+      };
+      walk(rootFd,"");
+      for(const held of opened)if(identity(fstatSync(held.fd,{bigint:true}))!==held.identity)refuse();
+      current();
+      return new HeldReviewNamespace(entries,current);
+    }catch{return refuse();}
+    finally{for(const held of opened.reverse())closeSync(held.fd);}
+  }
+  /** Parent replay reads the same held bytes that native resume consumes. */
+  transcripts(sessionId: string): {projectKey:string;cwd:string;main:unknown[];children:{subpath:string;entries:unknown[]}[]} {
+    this.#current();
+    if(!/^[0-9a-f-]{36}$/.test(sessionId))refuse();
+    const candidates=this.#entries.filter(entry=>!entry.directory &&
+      entry.name.startsWith("projects/") && entry.name.split("/").length===3 && entry.name.endsWith("/"+sessionId+".jsonl"));
+    if(candidates.length!==1)refuse();
+    const mainFile=candidates[0],projectKey=mainFile.name.split("/")[1];
+    const read=(entry:Entry):unknown[]=>{
+      const raw=new TextDecoder("utf-8",{fatal:true}).decode(Buffer.from(entry.bytes,"base64"));
+      const rows=raw.split("\n").filter(line=>line.trim().length).map(line=>JSON.parse(line));
+      if(!rows.length || rows.some(row=>!row || typeof row!=="object" || Array.isArray(row)))refuse();
+      return rows;
+    };
+    const main=read(mainFile);
+    const directories=new Set(main.map(row=>(row as {cwd?:unknown}).cwd).filter(value=>typeof value==="string"));
+    if(directories.size!==1)refuse();
+    const cwd=[...directories][0] as string;if(!isAbsolute(cwd))refuse();
+    const prefix="projects/"+projectKey+"/"+sessionId+"/";
+    const children=this.#entries.filter(entry=>!entry.directory && entry.name.startsWith(prefix) && entry.name.endsWith(".jsonl"))
+      .map(entry=>({subpath:entry.name.slice(prefix.length,-6),entries:read(entry)}));
+    this.#current();return {projectKey,cwd,main,children};
+  }
+  materialize(parent: string): {root: string; takeForSpawn: () => string; takeDirectoryForSpawn: () => number; persist: () => string; dispose: () => void} {
+    this.#current();
+    // parent belongs to the runtime, outside transcript export and user roots.
+    if(process.platform!=="linux" || !isAbsolute(parent))refuse();
+    const parentFd=openSync(parent,constants.O_RDONLY|constants.O_DIRECTORY|constants.O_NOFOLLOW);
+    let root:string|undefined;
+    try{
+      if((fstatSync(parentFd).mode&0o077)!==0)refuse();
+      // Use the retained directory allocation, not a path that could be swapped.
+      root=mkdtempSync(`/proc/${process.pid}/fd/${parentFd}/review-resume-`);
+      for(const entry of this.#entries){
+        const path=join(root,entry.name);
+        if(entry.directory)mkdirSync(path,{mode:0o700});
+        else{
+          const fd=openSync(path,"wx",0o600);
+          try{writeFileSync(fd,Buffer.from(entry.bytes,"base64"));fsyncSync(fd);}finally{closeSync(fd);}
+        }
+      }
+      this.#current();
+      let consumed=false,disposed=false;
+      const ownedRoot=root;
+      const takeForSpawn=()=>{
+        if(consumed||disposed)refuse();consumed=true;
+        this.#current();
+        if(HeldReviewNamespace.capture(ownedRoot,this.#current).componentDigest!==this.componentDigest)refuse();
+        return ownedRoot;
+      };
+      return {root:ownedRoot,takeForSpawn,takeDirectoryForSpawn:()=>{
+        const path=takeForSpawn();
+        return openSync(path,constants.O_RDONLY|constants.O_DIRECTORY|constants.O_NOFOLLOW);
+      },persist:()=>{
+        takeForSpawn();
+        // The private journal takes lifetime ownership before native use. Flush
+        // all directory entries before its atomic association can be committed.
+        for(const directory of [...this.#entries.filter(entry=>entry.directory).map(entry=>join(ownedRoot,entry.name)),ownedRoot]){
+          const fd=openSync(directory,constants.O_RDONLY|constants.O_DIRECTORY|constants.O_NOFOLLOW);
+          try{fsyncSync(fd);}finally{closeSync(fd);}
+        }
+        fsyncSync(parentFd);
+        const durableRoot=realpathSync(ownedRoot);
+        disposed=true;closeSync(parentFd);
+        return durableRoot;
+      },dispose:()=>{
+        if(disposed)return;disposed=true;
+        // The actual allocation owner must join native execution before calling.
+        try{rmSync(ownedRoot,{recursive:true,force:true});}finally{closeSync(parentFd);}
+      }};
+    }catch{try{if(root)rmSync(root,{recursive:true,force:true});}finally{closeSync(parentFd);}return refuse();}
+  }
+}
