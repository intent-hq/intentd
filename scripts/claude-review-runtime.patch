+  // not claim integrated new/load negotiation or original-account admission.
+  const current=agent.reviewAllocations.register(sessionId,{version:1,ownerKey:'fixture-owner',loadAttemptId},()=>{
+   joined=allocation.retire();closing.resolve();
+  },async()=>{await joined;q.close();await forwarder.promise;});
+  await assert.rejects(rpc.request('_intent/session/retire_review_context',{sessionId,loadAttemptId:'unknown'}));current();
+  const result=rpc.request('_intent/session/retire_review_context',{sessionId,loadAttemptId});
+  let replied=false;result.then(()=>{replied=true});await closing.promise;assert.throws(current);await joined;
+  // A subsequent malformed request is a deterministic dispatcher barrier while
+  // the original successful result remains held by its owned forwarder.
+  await assert.rejects(rpc.request('_intent/session/retire_review_context',{sessionId,loadAttemptId,extra:true}));
+  assert.equal(replied,false);
+  const replacement=agent.reviewAllocations.register(sessionId,{version:1,ownerKey:'fixture-owner',loadAttemptId:'replacement'},()=>{},async()=>{});
+  forwarder.resolve();assert.deepEqual(await result,{retired:true});replacement();
+  assert.deepEqual(await rpc.request('_intent/session/retire_review_context',{sessionId,loadAttemptId}),{retired:true});replacement();
+  t.diagnostic('actual pinned native initialization + real ACP retire dispatcher; registration and forwarder are controlled; no private prompt/model or new/load qualification');
+ }finally{
+  clearTimeout(timeout);forwarder.resolve();prompt.end();q?.close();if(allocation)await allocation.retire();
