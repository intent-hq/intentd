+import assert from 'node:assert/strict';
+import {test} from 'node:test';
+import {spawn} from 'node:child_process';
+import {once} from 'node:events';
+import {mkdtempSync,rmSync,readFileSync} from 'node:fs';
+import {tmpdir} from 'node:os';
+import {join} from 'node:path';
+import {query} from '@anthropic-ai/claude-agent-sdk';
+import {Pushable} from '../dist/utils.js';
+import {promptToClaude} from '../dist/acp-agent.js';
+import {ReviewMonitorJournal} from '../dist/review-monitoring-journal.js';
+import {monitorPayloadDigest} from '../dist/review-monitoring.js';
+
+// Real SDK ProcessTransport and owned subprocess; the model/CLI peer is
+// controlled. This does not prove native resume or descendant containment.
+const peer = `
+const fs=require('node:fs'), readline=require('node:readline');
+const lines=readline.createInterface({input:process.stdin});
+const send=value=>process.stdout.write(JSON.stringify(value)+'\\n');
+lines.on('line',line=>{
+ const frame=JSON.parse(line);
+ if(frame.type==='control_request') {
+  send({type:'control_response',response:{subtype:'success',request_id:frame.request_id,response:{commands:[],models:[],account:{}}}});
+ } else if(frame.type==='user') {
+  fs.writeFileSync(process.env.REVIEW_TEST_FRAME,JSON.stringify(frame));
+  send({...frame,isReplay:true,parent_tool_use_id:null});
+  send({type:'result',subtype:'success',session_id:frame.session_id,uuid:require('node:crypto').randomUUID(),user_message_uuid:frame.uuid,origin:frame.origin,stop_reason:'end_turn',is_error:false,result:'',duration_ms:1,duration_api_ms:1,num_turns:1,total_cost_usd:0,usage:{input_tokens:1,output_tokens:1,cache_read_input_tokens:0,cache_creation_input_tokens:0},modelUsage:{},permission_denials:[]});
+ }
+});
+lines.on('close',()=>process.exit(0));
+`;
+
+for (const qualified of [false,true]) test(`actual SDK preserves ${qualified?'journal-classified monitor':'ordinary human'} input`,{timeout:15000},async t=>{
+ const root=mkdtempSync(join(tmpdir(),'intent-review-sdk-'));
+ t.after(()=>rmSync(root,{recursive:true,force:true}));
+ const journal=new ReviewMonitorJournal(join(root,'private'),true);
+ t.after(()=>journal.close());
+ const sessionId=journal.enroll('original-owner'),text='/mcp:private:command exact text';
+ const messageId='original-message',storeEnvelopeDigest='a'.repeat(64);
+ const params={sessionId,prompt:[{type:'text',text}],...(qualified?{_meta:{reviewMonitoringMessage:{version:1,messageId,storeEnvelopeDigest,acpPayloadDigest:monitorPayloadDigest(sessionId,messageId,storeEnvelopeDigest,text)}}}:{})};
+ const token=qualified?journal.prepareInput(sessionId,'original-owner',params):undefined;
+ const converted=promptToClaude(params,token);
+ const input=new Pushable();
+ let child,exit;
+ const q=query({prompt:input,options:{sessionId,cwd:root,settingSources:[],persistSession:false,
+  spawnClaudeCodeProcess(){
+   child=spawn(process.execPath,['-e',peer],{cwd:root,env:{...process.env,NODE_OPTIONS:'',REVIEW_TEST_FRAME:join(root,'frame')},stdio:['pipe','pipe','pipe']});
+   exit=once(child,'exit');
+   return child;
+  }
+ }});
+ t.after(async()=>{input.end();q.close();if(child?.exitCode===null && child?.signalCode===null)child.kill('SIGKILL');if(exit)await exit;});
+ await q.initializationResult();
+ input.push(converted);
+ let result;
+ for await(const frame of q){if(frame.type==='result'){result=frame;break;}}
+ assert.ok(result);
+ const actual=JSON.parse(readFileSync(join(root,'frame'),'utf8'));
+ assert.equal(actual.origin.kind,qualified?'task-notification':'human');
+ assert.deepEqual(actual.message,converted.message);
+ assert.equal(actual.uuid,converted.uuid);
+ if(qualified){
+  assert.equal(actual.uuid,journal.recordBeforeFeed(sessionId,'original-owner',params));
+  assert.equal(JSON.parse(actual.message.content[0].text.split('\nPayload: ')[1]).text,text);
+  assert.equal(result.user_message_uuid,actual.uuid);
+  assert.equal(result.origin.kind,'task-notification');
+  assert.throws(()=>promptToClaude(params,token),/unavailable/);
+ }
+ input.end();q.close();await exit;
+ assert.notEqual(child.exitCode,null,'join the owned child before completion');
+});
