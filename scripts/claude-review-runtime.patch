+ const payloadUrl=new URL('../dist/review-monitoring.js',import.meta.url).href;
+ const code=`import {ReviewMonitorJournal} from ${JSON.stringify(moduleUrl)};import {monitorPayloadDigest} from ${JSON.stringify(payloadUrl)};const j=new ReviewMonitorJournal(process.argv[1],true);const sessionId=j.enroll('owner'),messageId='held',storeEnvelopeDigest='a'.repeat(64),text='private';const prompt={sessionId,prompt:[{type:'text',text}],_meta:{reviewMonitoringMessage:{version:1,messageId,storeEnvelopeDigest,acpPayloadDigest:monitorPayloadDigest(sessionId,messageId,storeEnvelopeDigest,text)}}};const uuid=j.recordBeforeFeed(sessionId,'owner',prompt);process.send({sessionId,uuid,prompt});setInterval(()=>{},1000);`;
