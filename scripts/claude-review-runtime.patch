+      } else {
+        safeFile(join(root,"key"));safeFile(join(root,"ledger"));
+        this.#key=readFileSync(join(root,"key"));
+        if(this.#key.length!==32) refuse();
+        this.#wire=readFileSync(join(root,"ledger"),"utf8");
+        this.#ledger=this.#decode(this.#wire);
