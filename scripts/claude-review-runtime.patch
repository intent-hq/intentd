diff --git a/src/review-monitoring-process.ts b/src/review-monitoring-process.ts
new file mode 100644
--- /dev/null
+++ b/src/review-monitoring-process.ts
@@ -0,0 +1,70 @@
+import { spawn, spawnSync, type ChildProcessWithoutNullStreams } from "node:child_process";
+import { closeSync } from "node:fs";
+import type { SpawnOptions, SpawnedProcess } from "@anthropic-ai/claude-agent-sdk";
+
+function refuse(): never { throw new Error("Review monitoring process unavailable"); }
+
+/** Availability check only; artifact authentication belongs to the runtime installer. */
+export function assertReviewContainmentAvailable(executable = "/usr/bin/bwrap"): void {
+  if(process.platform !== "linux" || !executable.startsWith("/"))refuse();
+  const probe=spawnSync(executable,["--unshare-user","--unshare-pid","--die-with-parent","--new-session",
+    "--ro-bind","/","/","--proc","/proc","--dev","/dev","--",process.execPath,
+    "-e","process.stdout.write('intent-review-containment-ready')"],
+    {env:{PATH:"/usr/bin:/bin",NODE_OPTIONS:"",LD_PRELOAD:""},encoding:"utf8",timeout:5000,killSignal:"SIGKILL"});
+  if(probe.error || probe.status !== 0 || probe.stdout !== "intent-review-containment-ready")refuse();
+}
+
+/** One Linux allocation, never a shared adapter. Namespace lifetime is retained
+ * by bubblewrap's sync descriptor and all owned transport pipes. Retirement
+ * closes local input eligibility synchronously, then joins those resources.
+ * This is process containment, not forge admission or a recall of prior external
+ * requests. The caller must separately fence callbacks and late responses.
+ */
+export class ReviewProcessAllocation {
+  readonly process: SpawnedProcess;
+  readonly #child: ChildProcessWithoutNullStreams;
+  readonly #joined: Promise<void>;
+  #retired=false;
+  constructor(options: SpawnOptions, writableRoots: readonly string[], current: () => void, nativeConfigFd?: number, containmentExecutable = "/usr/bin/bwrap") {
+    let child;
+    try {
+    if(process.platform!=="linux")refuse();
+    current();
+    // The actual runtime owns the writable roots and exact command/environment.
+    // No optional namespace or ordinary-spawn fallback on unsupported hosts.
+    const args=["--unshare-user","--unshare-pid","--die-with-parent","--new-session",
+      "--ro-bind","/","/","--proc","/proc","--dev","/dev","--sync-fd","3"];
+    for(const root of writableRoots)args.push("--bind",root,root);
+    if (nativeConfigFd !== undefined) {
+      if (options.env.CLAUDE_CONFIG_DIR !== "/run/intent-review/config") refuse();
+      args.push("--tmpfs","/run","--dir","/run/intent-review",
+        "--dir","/run/intent-review/tmp",
+        "--bind-fd","4","/run/intent-review/config");
+    }
+    args.push("--",options.command,...options.args);
+    // Ownership of the already-open native directory is transferred here.
+    // The sandbox cannot reopen its parent's /proc path after userns setup.
+      child=spawn(containmentExecutable,args,{cwd:options.cwd,env:options.env,
+        stdio:nativeConfigFd === undefined ? ["pipe","pipe","pipe","pipe"] : ["pipe","pipe","pipe","pipe",nativeConfigFd]});
+    } finally { if(nativeConfigFd !== undefined)closeSync(nativeConfigFd); }
+    this.#child=child as ChildProcessWithoutNullStreams;
+    this.process=this.#child;
+    this.#joined=new Promise<void>((resolve,reject)=>{
+      child.once("error",()=>reject(new Error("Review monitoring process unavailable")));
+      // ChildProcess.close joins every stdio descriptor, including the private
+      // sync FD held for the sandbox lifetime, not merely the direct exit event.
+      child.once("close",()=>{this.#retired=true;resolve();});
+    });
+    // Join errors remain observable even if the SDK abandons initialization.
+    void this.#joined.catch(()=>{});
+  }
+  assertCurrent(): void { if(this.#retired)refuse(); }
+  retire(): Promise<void> {
+    if(!this.#retired){
+      this.#retired=true;
+      this.#child.stdin.destroy();
+      this.#child.kill("SIGKILL");
+    }
+    return this.#joined;
+  }
+}
