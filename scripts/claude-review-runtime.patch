+import assert from 'node:assert/strict';
+import {test} from 'node:test';
+import {mkdtempSync,mkdirSync,rmSync,readFileSync} from 'node:fs';
+import {tmpdir} from 'node:os';
+import {join} from 'node:path';
+import {createHash,randomUUID} from 'node:crypto';
+import {query} from '@anthropic-ai/claude-agent-sdk';
+import {claudeCliPath} from '../dist/acp-agent.js';
+import {Pushable} from '../dist/utils.js';
+import {HeldReviewNamespace} from '../dist/review-monitoring-namespace.js';
+import {ReviewProcessAllocation} from '../dist/review-monitoring-process.js';
+
+test('pinned native Claude initializes inside its original owned namespace and joins retirement',{timeout:30000},async t=>{
+ const root=mkdtempSync(join(tmpdir(),'intent-review-native-'));
+ const source=join(root,'source'),dest=join(root,'held'),work=join(root,'work');
+ for(const path of [source,dest,work])mkdirSync(path,{mode:0o700});
+ const snapshot=HeldReviewNamespace.capture(source,()=>{}),namespace=snapshot.materialize(dest);
+ const cli=await claudeCliPath();
+ t.diagnostic('native binary SHA256 '+createHash('sha256').update(readFileSync(cli)).digest('hex'));
+ const input=new Pushable();let allocation,q,error='';
+ const timeout=setTimeout(()=>{if(allocation)void allocation.retire();},20000);
+ try{
+  q=query({prompt:input,options:{sessionId:randomUUID(),cwd:work,settingSources:[],pathToClaudeCodeExecutable:cli,
+   env:{PATH:process.env.PATH,NODE_OPTIONS:'',TMPDIR:work,CLAUDE_CONFIG_DIR:'/run/intent-review/config',CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC:'1',DISABLE_TELEMETRY:'1',DISABLE_AUTOUPDATER:'1'},
+   spawnClaudeCodeProcess(options){
+    allocation=new ReviewProcessAllocation(options,[work],()=>{},namespace.takeDirectoryForSpawn());
+    allocation.process.stderr.on('data',chunk=>{error+=chunk});return allocation.process;
+   }
+  }});
+  const result=await q.initializationResult();
+  assert.ok(result,'actual native initialize response');
+  allocation.assertCurrent();
+  const joined=allocation.retire();assert.throws(()=>allocation.assertCurrent(),/unavailable/);await joined;
+  t.diagnostic('actual native initialization and joined retirement; no user/model prompt sent');
+ }catch(e){throw new Error('Native initialization/retirement failed: '+e.message+' stderr='+error.slice(-2000));}
+ finally{clearTimeout(timeout);input.end();q?.close();if(allocation)await allocation.retire();namespace.dispose();rmSync(root,{recursive:true,force:true});}
+});
diff --git a/src/review-monitoring-allocations.ts b/src/review-monitoring-allocations.ts
new file mode 100644
--- /dev/null
+++ b/src/review-monitoring-allocations.ts
@@ -0,0 +1,92 @@
+import { parseReviewContext, type ReviewContext } from "./review-monitoring.js";
+
+function refuse(): never { throw new Error("Review monitoring allocation unavailable"); }
+export function parseReviewRetirement(value: unknown): {sessionId: string; loadAttemptId: string} {
+  if (!value || typeof value !== "object" || Array.isArray(value)) refuse();
+  const row=value as Record<string,unknown>;
+  if (Object.keys(row).length!==2 || !Object.hasOwn(row,"sessionId") || !Object.hasOwn(row,"loadAttemptId")) refuse();
+  for (const key of ["sessionId","loadAttemptId"]) {
+    if(typeof row[key]!=="string" || !row[key].length || !row[key].isWellFormed() || Buffer.byteLength(row[key])>256) refuse();
+  }
+  return {sessionId:row.sessionId as string,loadAttemptId:row.loadAttemptId as string};
+}
+type Allocation = {
+  context: ReviewContext;
+  closeEligibility: () => void;
+  join: () => Promise<void>;
+  retired: boolean;
+  retirement?: Promise<{retired:true}>;
+};
+
+/** Connection-owned exact allocation lifetimes. Registration is internal and
+ * follows original physical startup allocation; public IDs never create one.
+ * closeEligibility must synchronously fence queued/autonomous dispatch and
+ * callbacks; join owns the exact Query, native tree and forwarding tasks.
+ * A failed join stays failed, never becoming a successful tombstone.
+ */
+export class ReviewAllocations {
+  readonly #sessions=new Map<string,Map<string,Allocation>>();
+  #closed=false;
+  assertOpen():void { if(this.#closed)refuse(); }
+  register(sessionId: string, context: ReviewContext, closeEligibility: () => void, join: () => Promise<void>): () => void {
+    parseReviewRetirement({sessionId,loadAttemptId:context.loadAttemptId});
+    const held=parseReviewContext(context);
+    if(this.#closed)refuse();
+    let attempts=this.#sessions.get(sessionId);
+    if(!attempts){attempts=new Map();this.#sessions.set(sessionId,attempts);}
+    // Never reparent or replace an already known attempt, including tombstones.
+    if(attempts.has(held.loadAttemptId) || [...attempts.values()].some(a=>!a.retired))refuse();
+    const allocation:Allocation={context:held,closeEligibility,join,retired:false};
+    attempts.set(held.loadAttemptId,allocation);
+    return ()=>{if(this.#closed || allocation.retired)refuse();};
+  }
+  retire(value: unknown): Promise<{retired:true}> {
+    const {sessionId,loadAttemptId}=parseReviewRetirement(value);
+    const allocation=this.#sessions.get(sessionId)?.get(loadAttemptId);
+    if(!allocation)refuse();
+    return this.#retire(allocation);
+  }
+  #retire(allocation:Allocation):Promise<{retired:true}> {
+    if(allocation.retirement)return allocation.retirement;
+    allocation.retired=true;
+    // Install the exact shared result before invoking owner callbacks, including
+    // reentrant retirement. Eligibility closes before any asynchronous work.
+    let resolve!:(result:{retired:true})=>void,reject!:(reason:unknown)=>void;
+    allocation.retirement=new Promise((yes,no)=>{resolve=yes;reject=no;});
+    void allocation.retirement.catch(()=>{});
+    let eligibilityFailed=false;
+    try { allocation.closeEligibility(); } catch { eligibilityFailed=true; }
+    // Even a failing fence callback must not abandon the exact owned child.
+    try {
+      Promise.resolve(allocation.join()).then(()=>{
+        if(eligibilityFailed)reject(new Error("Review monitoring allocation unavailable"));
+        else resolve({retired:true});
+      },()=>reject(new Error("Review monitoring allocation unavailable")));
+    } catch { reject(new Error("Review monitoring allocation unavailable")); }
+    return allocation.retirement;
+  }
+  close():Promise<void> {
+    this.#closed=true;
+    // Start every synchronous retirement before awaiting any individual join.
+    const joins=[...this.#sessions.values()].flatMap(attempts=>[...attempts.values()].map(a=>this.#retire(a)));
+    return Promise.allSettled(joins).then(results=>{if(results.some(result=>result.status==='rejected'))refuse();});
+  }
+}
+
+/** A prepared attempt already owns retirement before it can start a Query.
+ * Activation replaces only its internal callbacks, never its public identity. */
+export class ReviewStartupReservation {
+  readonly #current: () => void;
+  readonly #allocations: ReviewAllocations;
+  readonly #selector: {sessionId:string;loadAttemptId:string};
+  #owner?: {close:()=>void;join:()=>Promise<void>};
+  constructor(allocations: ReviewAllocations, sessionId: string, context: ReviewContext) {
+    this.#allocations=allocations;this.#selector={sessionId,loadAttemptId:context.loadAttemptId};
+    this.#current=allocations.register(sessionId,context,()=>this.#owner?.close(),async()=>{await this.#owner?.join();});
+  }
+  assertCurrent():void { this.#current(); }
+  attach(close:()=>void,join:()=>Promise<void>):()=>void {
+    this.#current();if(this.#owner)refuse();this.#owner={close,join};return this.#current;
+  }
+  retire():Promise<{retired:true}>{return this.#allocations.retire(this.#selector);}
+}
