+ mkdirSync(join(source,'projects'));mkdirSync(join(source,'projects','original'));
+ writeFileSync(join(source,'projects','original','session.jsonl'),'original private transcript\n');
+ writeFileSync(join(source,'settings.json'),'{"original":true}');
+ writeFileSync(join(source,'binary'),Buffer.from([0,255,128]));
+ t.after(()=>rmSync(root,{recursive:true,force:true}));return {root,source,dest};
+}
+test('held full tree remains exact after original mutation and reaches an owned child through retained directory',t=>{
+ const {source,dest}=setup(t);
+ const held=HeldReviewNamespace.capture(source,()=>{});
+ writeFileSync(join(source,'settings.json'),'changed after capture');
+ const allocation=held.materialize(dest);t.after(()=>allocation.dispose());
+ const path=allocation.takeForSpawn();
+ const child=spawnSync(process.execPath,['-e',"process.stdout.write(require('fs').readFileSync(process.argv[1]))",join(path,'settings.json')],{env:{PATH:process.env.PATH,NODE_OPTIONS:''},encoding:'utf8'});
+ assert.equal(child.status,0,child.stderr);assert.equal(child.stdout,'{"original":true}');
+ assert.deepEqual(readFileSync(join(path,'binary')),Buffer.from([0,255,128]));
+ assert.equal(HeldReviewNamespace.capture(path,()=>{}).componentDigest,held.componentDigest);
+ assert.throws(()=>allocation.takeForSpawn(),/unavailable/);
+});
+for(const mode of ['symlink','hardlink','shared-root'])test(`capture refuses ${mode}`,t=>{
+ const {source}=setup(t);
+ if(mode==='symlink')symlinkSync('/does-not-exist',join(source,'linked'));
+ if(mode==='hardlink')linkSync(join(source,'settings.json'),join(source,'linked'));
+ if(mode==='shared-root')chmodSync(source,0o755);
+ assert.throws(()=>HeldReviewNamespace.capture(source,()=>{}),/unavailable/);
+});
+for(const mode of ['tamper','retirement'])test(`held spawn refuses ${mode}`,t=>{
+ const {source,dest}=setup(t);let active=true;
+ const held=HeldReviewNamespace.capture(source,()=>{if(!active)throw new Error('Review monitoring history unavailable');});
+ const allocation=held.materialize(dest);t.after(()=>allocation.dispose());
+ if(mode==='tamper')writeFileSync(join(allocation.root,'settings.json'),'replaced');else active=false;
+ assert.throws(()=>allocation.takeForSpawn(),/unavailable/);
+ active=true;assert.throws(()=>allocation.takeForSpawn(),/unavailable/);
+});
+test('renaming the materialization parent does not rebind the owned snapshot',t=>{
+ const {root,source,dest}=setup(t);
