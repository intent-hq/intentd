diff --git a/src/review-monitoring.ts b/src/review-monitoring.ts
new file mode 100644
--- /dev/null
+++ b/src/review-monitoring.ts
@@ -0,0 +1,123 @@
+import { createHash, randomUUID } from "node:crypto";
+
+export const REVIEW_CONTEXT = "reviewMonitoringContext";
+export const REVIEW_MESSAGE = "reviewMonitoringMessage";
+export const REVIEW_HISTORY = "reviewMonitoringHistory";
+export const PREPARE_HISTORY = "_intent/session/prepare_review_history";
+export const RETIRE_CONTEXT = "_intent/session/retire_review_context";
+
+export type ReviewContext = Readonly<{
+  version: 1;
+  ownerKey: string;
+  loadAttemptId: string;
+}>;
+export type MonitorCorrelation = Readonly<{
+  messageId: string;
+  storeEnvelopeDigest: string;
+  acpPayloadDigest: string;
+}>;
+export type MonitorPrompt = Readonly<MonitorCorrelation & {
+  sessionId: string;
+  text: string;
+}>;
+
+function fail(): never {
+  // Neither correlation nor payload belongs in the error or logs.
+  throw new Error("Review monitoring context unavailable");
+}
+function object(value: unknown): Record<string, unknown> {
+  if (value === null || typeof value !== "object" || Array.isArray(value)) fail();
+  return value as Record<string, unknown>;
+}
+function exact(value: unknown, keys: readonly string[]): Record<string, unknown> {
+  const result = object(value);
+  if (Object.keys(result).length !== keys.length || keys.some((key) => !Object.hasOwn(result, key))) fail();
+  return result;
+}
+function string(value: unknown, limit: number): string {
+  if (typeof value !== "string" || value.length === 0 || Buffer.byteLength(value, "utf8") > limit || !value.isWellFormed()) fail();
+  return value;
+}
+function digest(value: unknown): string {
+  if (typeof value !== "string" || !/^[0-9a-f]{64}$/.test(value)) fail();
+  return value;
+}
+export function parseReviewContext(value: unknown): ReviewContext {
+  const context = exact(value, ["version", "ownerKey", "loadAttemptId"]);
+  if (context.version !== 1) fail();
+  return Object.freeze({ version: 1, ownerKey: string(context.ownerKey, 256), loadAttemptId: string(context.loadAttemptId, 256) });
+}
+export function sameReviewContext(a: ReviewContext, b: ReviewContext): boolean {
+  return a.version === b.version && a.ownerKey === b.ownerKey && a.loadAttemptId === b.loadAttemptId;
+}
+export function reviewMonitoringOffered(value: unknown): boolean {
+  return typeof value === "number" && Number.isSafeInteger(value) && value >= 1;
+}
+
+// Strict v1 accepts exactly one text block and the classification sibling only.
+// The compact JSON array commits every accepted varying field, including both
+// correlations. Constant field names/types/version belong to the domain. UTF-8,
+// no whitespace/BOM/newline, no Unicode normalization; malformed UTF-16 refuses.
+export function monitorPayloadDigest(sessionId: string, messageId: string, storeEnvelopeDigest: string, text: string): string {
+  string(sessionId, 256);
+  string(messageId, 256);
+  digest(storeEnvelopeDigest);
+  if (typeof text !== "string" || !text.isWellFormed()) fail();
+  return createHash("sha256").update(JSON.stringify([
+    "intent-review-monitor-acp-text-v1", sessionId, messageId, storeEnvelopeDigest, text,
+  ]), "utf8").digest("hex");
+}
+export function parseMonitorPrompt(value: unknown): MonitorPrompt | undefined {
+  const candidate = object(value);
+  const meta = candidate._meta;
+  if (meta === null || typeof meta !== "object" || Array.isArray(meta) || !Object.hasOwn(meta, REVIEW_MESSAGE)) return undefined;
+  const request = exact(candidate, ["sessionId", "prompt", "_meta"]);
+  const classification = exact(exact(request._meta, [REVIEW_MESSAGE])[REVIEW_MESSAGE], [
+    "version", "messageId", "storeEnvelopeDigest", "acpPayloadDigest",
+  ]);
+  if (classification.version !== 1 || !Array.isArray(request.prompt) || request.prompt.length !== 1) fail();
+  const block = exact(request.prompt[0], ["type", "text"]);
+  if (block.type !== "text" || typeof block.text !== "string" || !block.text.isWellFormed()) fail();
+  const sessionId = string(request.sessionId, 256);
+  const messageId = string(classification.messageId, 256);
+  const storeEnvelopeDigest = digest(classification.storeEnvelopeDigest);
+  const acpPayloadDigest = digest(classification.acpPayloadDigest);
+  if (acpPayloadDigest !== monitorPayloadDigest(sessionId, messageId, storeEnvelopeDigest, block.text)) fail();
+  return Object.freeze({ sessionId, messageId, storeEnvelopeDigest, acpPayloadDigest, text: block.text });
+}
+
+/** Opaque single-use preparation ownership. Snapshot storage/admission is separate. */
+export class ReviewPreparations<T> {
+  #generation = 0;
+  #plans = new Map<string, { generation: number; context: ReviewContext; sessionId: string; snapshotDigest: string; expires: number; snapshot: T }>();
+  private readonly now: () => number;
+  constructor(now: () => number = Date.now) { this.now = now; }
+  /** Capture before asynchronous snapshot work. Retain this guard in the held
+   * input owner after one-use consume; reinitialization must also invalidate
+   * inputs already handed to parent readers or deferred SDK materialization. */
+  captureCurrent(): () => void {
+    const generation = this.#generation;
+    return () => { if (generation !== this.#generation) fail(); };
+  }
+  retire(): void {
+    this.#generation++;
+    this.#plans.clear();
+  }
+  prepare(context: ReviewContext, sessionId: string, snapshotDigest: string, snapshot: T): string {
+    string(sessionId, 256);
+    digest(snapshotDigest);
+    for (const [id, plan] of this.#plans) if (plan.expires <= this.now()) this.#plans.delete(id);
+    if (this.#plans.size >= 32) fail();
+    const id = randomUUID();
+    this.#plans.set(id, { generation: this.#generation, context: parseReviewContext(context), sessionId, snapshotDigest, expires: this.now() + 30_000, snapshot });
+    return id;
+  }
+  consume(id: string, context: ReviewContext, sessionId: string, snapshotDigest: string): T {
+    const plan = this.#plans.get(id);
+    // Burn before validation and before any caller can await/spawn. No retry of
+    // unknown startup outcome; the snapshot is not a delivery acknowledgement.
+    this.#plans.delete(id);
+    if (!plan || plan.generation !== this.#generation || plan.expires <= this.now() || !sameReviewContext(plan.context, context) || plan.sessionId !== sessionId || plan.snapshotDigest !== snapshotDigest) fail();
+    return plan.snapshot;
+  }
+}
