+import {ReviewProcessAllocation} from '../dist/review-monitoring-process.js';
+import {RpcLines,deferred} from './mcp-peer.mjs';
+
+test('actual retire RPC joins exact native startup and retained forwarder without targeting a replacement',{timeout:30000},async t=>{
+ const input=new PassThrough(),output=new PassThrough();
+ const {agent,connection}=runAcp({log(){},error(){},warn(){},debug(){}},ndJsonStream(Writable.toWeb(output),Readable.toWeb(input)));
+ const rpc=new RpcLines(output,input),root=mkdtempSync(join(tmpdir(),'intent-review-retire-rpc-'));
+ const source=join(root,'source'),dest=join(root,'held'),work=join(root,'work');
+ for(const path of [source,dest,work])mkdirSync(path,{mode:0o700});
+ const namespace=HeldReviewNamespace.capture(source,()=>{}).materialize(dest),prompt=new Pushable();
+ const sessionId=randomUUID(),loadAttemptId=randomUUID(),cli=await claudeCliPath();
+ const forwarder=deferred(),closing=deferred();let allocation,q,joined;
+ const timeout=setTimeout(()=>{forwarder.resolve();if(allocation)void allocation.retire();},20000);
+ try{
+  q=query({prompt,options:{sessionId,cwd:work,settingSources:[],pathToClaudeCodeExecutable:cli,
+   env:{PATH:process.env.PATH,NODE_OPTIONS:'',TMPDIR:work,CLAUDE_CONFIG_DIR:'/run/intent-review/config',CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC:'1',DISABLE_TELEMETRY:'1',DISABLE_AUTOUPDATER:'1'},
+   spawnClaudeCodeProcess(options){allocation=new ReviewProcessAllocation(options,[work],()=>{},namespace.takeDirectoryForSpawn());return allocation.process;}
+  }});
+  await q.initializationResult();
