+ const allocation=held.materialize(dest);t.after(()=>allocation.dispose());
+ renameSync(dest,join(root,'old-held'));mkdirSync(dest,{mode:0o700});
+ const original=allocation.takeForSpawn();
+ assert.equal(readFileSync(join(original,'settings.json'),'utf8'),'{"original":true}');
+});
+
+for(const retired of [false,true])test(`actual SDK original namespace launch, retired=${retired}`,{timeout:15000},async t=>{
+ const {query}=await import('@anthropic-ai/claude-agent-sdk');
+ const {Pushable}=await import('../dist/utils.js');
+ const {spawn}=await import('node:child_process');
+ const {once}=await import('node:events');
+ const {randomUUID}=await import('node:crypto');
+ const {root,source,dest}=setup(t);let active=true;
+ const held=HeldReviewNamespace.capture(source,()=>{if(!active)throw new Error('Review monitoring history unavailable');});
+ const allocation=held.materialize(dest);
+ writeFileSync(join(source,'settings.json'),'ambient source changed');
+ let child,exit,spawned=0;const input=new Pushable();
+ const peer=`const fs=require('fs'),readline=require('readline');
+ const root=process.env.CLAUDE_CONFIG_DIR;
+ fs.writeFileSync(process.env.REVIEW_TEST_OUTPUT,JSON.stringify({settings:fs.readFileSync(root+'/settings.json','utf8'),history:fs.readFileSync(root+'/projects/original/session.jsonl','utf8')}));
+ readline.createInterface({input:process.stdin}).on('line',line=>{const f=JSON.parse(line);if(f.type==='control_request')process.stdout.write(JSON.stringify({type:'control_response',response:{subtype:'success',request_id:f.request_id,response:{commands:[],models:[],account:{}}}})+'\\n');}).on('close',()=>process.exit(0));`;
+ let q;
+ const start=()=>query({prompt:input,options:{resume:randomUUID(),cwd:root,settingSources:[],env:{PATH:process.env.PATH,CLAUDE_CONFIG_DIR:allocation.root},
+  spawnClaudeCodeProcess(options){
+   if(retired)active=false;
+   assert.equal(options.env.CLAUDE_CONFIG_DIR,allocation.takeForSpawn());
+   spawned++;
