+const store='a'.repeat(64);
+function request(text='private\n雪😀') {
+  return {sessionId:'session',prompt:[{type:'text',text}],_meta:{reviewMonitoringMessage:{version:1,messageId:'message',storeEnvelopeDigest:store,acpPayloadDigest:monitorPayloadDigest('session','message',store,text)}}};
+}
+test('complete accepted prompt correlation and Unicode encoding',()=>{
+  const value=request();
+  assert.equal(parseMonitorPrompt(value).text,value.prompt[0].text);
+  for(const mutate of [p=>p.sessionId='other',p=>p.prompt[0].text+='!',p=>p._meta.reviewMonitoringMessage.messageId='other',p=>p._meta.reviewMonitoringMessage.storeEnvelopeDigest='b'.repeat(64)]) {
+    const p=request();mutate(p);assert.throws(()=>parseMonitorPrompt(p),/unavailable/);
+  }
+  assert.notEqual(monitorPayloadDigest('session','message',store,'é'),monitorPayloadDigest('session','message',store,'e\u0301'));
+  assert.throws(()=>monitorPayloadDigest('session','message',store,'\ud800'),/unavailable/);
+});
+test('classified rich/extra fields cannot disappear before hashing; ordinary rich blocks unaffected',()=>{
+  for(const mutate of [p=>p.prompt.push({type:'text',text:'extra'}),p=>p.prompt[0]._meta={private:'extra'},p=>p.prompt[0].attachment='extra',p=>p._meta.other='extra',p=>p.unknown='extra',p=>p._meta.reviewMonitoringMessage.extra=true,p=>p.prompt[0].type='resource']) {
+    const p=request();mutate(p);assert.throws(()=>parseMonitorPrompt(p),/unavailable/);
+  }
+  const ordinary={sessionId:'s',prompt:[{type:'image',data:'x',mimeType:'image/png',_meta:{ordinary:true}}],_meta:{ordinary:'kept'}};
+  assert.equal(parseMonitorPrompt(ordinary),undefined);
+  assert.equal(ordinary.prompt[0]._meta.ordinary,true);
+});
+test('one-use preparation is consumed before any subsequent work and bound to full original context',()=>{
+  const plans=new ReviewPreparations();const snapshot=Object.freeze({bytes:'exact held snapshot'});
+  const id=plans.prepare(context,'session',store,snapshot);
+  assert.equal(plans.consume(id,context,'session',store),snapshot);
+  assert.throws(()=>plans.consume(id,context,'session',store),/unavailable/);
+  for(const mismatch of [{...context,ownerKey:'other'},{...context,loadAttemptId:'other'}]) {
+    const next=plans.prepare(context,'session',store,snapshot);
+    assert.throws(()=>plans.consume(next,mismatch,'session',store),/unavailable/);
+    assert.throws(()=>plans.consume(next,context,'session',store),/unavailable/);
+  }
+});
+test('reinitialization, timeout, bad destination and full closure digest cannot select held history',()=>{
+  let now=0;const plans=new ReviewPreparations(()=>now);
+  let id=plans.prepare(context,'session',store,{});plans.retire();assert.throws(()=>plans.consume(id,context,'session',store));
+  id=plans.prepare(context,'session',store,{});now=30_000;assert.throws(()=>plans.consume(id,context,'session',store));
+  for(const [session,digest] of [['other',store],['session','b'.repeat(64)]]) {
+    id=plans.prepare(context,'session',store,{});assert.throws(()=>plans.consume(id,context,session,digest));
+  }
+  assert.throws(()=>parseReviewContext({...context,extra:true}));
+});
+test('receiver verifies the exact shared daemon vectors',async()=>{
+  const {readFile}=await import('node:fs/promises');
+  const vectors=JSON.parse(await readFile(new URL('./fixtures/review-monitoring-payload-v1.json',import.meta.url),'utf8'));
+  for(const vector of vectors) {
+    assert.equal(parseMonitorPrompt(vector.classified).acpPayloadDigest,vector.classified._meta.reviewMonitoringMessage.acpPayloadDigest);
+  }
+});
