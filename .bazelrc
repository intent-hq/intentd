# Bazel settings for the intentd workspace. See bazel/README.md.

common --enable_bzlmod
common --lockfile_mode=update

# Embed the build commit (bazel/workspace_status.sh) the way Cargo's
# intent-transport build script does.
build --workspace_status_command=bazel/workspace_status.sh
build --stamp

# Unlock dependent crates as soon as a dependency's .rmeta is ready, like
# Cargo's pipelining.
build --@rules_rust//rust/settings:pipelined_compilation=True

# Build proc-macros, build scripts and their deps unoptimized, like Cargo's dev
# profile; Bazel's default exec configuration compiles them with `opt`.
build --host_compilation_mode=fastbuild

# Keep host environment out of action keys.
build --incompatible_strict_action_env

# ---------------------------------------------------------------------------
# Tests and lints. Generated targets: scripts/bazel-gen.py; see bazel/README.md.
# ---------------------------------------------------------------------------

# nextest parity (.config/nextest.toml): `retries = 1` is one extra attempt.
# nextest's 180 s per-test kill has no Bazel equivalent (Bazel times out whole
# test binaries); the default per-size timeouts apply instead.
test --flaky_test_attempts=2
test --test_output=errors

# Tests find node (and other host tools) on the host PATH, as under Cargo; the
# strict action env would otherwise cut it to /bin:/usr/bin:/usr/local/bin.
# Known non-hermetic input, to be replaced by a hermetic node toolchain
# (rules_nodejs) in the test-hermeticity phase.
test --test_env=PATH

# --config=clippy: `cargo clippy --workspace --all-targets -- -D warnings`.
# [workspace.lints] reaches clippy through each crate's `cargo_lints` target.
build:clippy --aspects=@rules_rust//rust:defs.bzl%rust_clippy_aspect
build:clippy --output_groups=+clippy_checks
build:clippy --@rules_rust//rust/settings:clippy_flag=-Dwarnings

# --config=rustfmt: `cargo fmt --check`.
build:rustfmt --aspects=@rules_rust//rust:defs.bzl%rustfmt_aspect
build:rustfmt --output_groups=+rustfmt_checks

# Local overrides (cache paths, jobs) stay out of the repo.
try-import %workspace%/user.bazelrc

# ---------------------------------------------------------------------------
# CI and remote cache. Keep this section last; see bazel/README.md.
# ---------------------------------------------------------------------------

# --config=ci: plain logs and test results that are never served from a cache.
# Tests still read undeclared host inputs, so a cached pass would not mean what
# a Cargo pass means; drop --nocache_test_results once test inputs are audited.
# The lock stays in the default `update` mode: after a release bump CI
# re-resolves from Cargo.lock (the pinned source of truth) and never commits
# or uploads the refreshed lock. The drift job (scripts/bazel-drift.py) is
# what enforces the lock.
common:ci --curses=no
common:ci --color=no
common:ci --show_progress_rate_limit=30
build:ci --verbose_failures
test:ci --test_output=errors
test:ci --nocache_test_results

# --config=remote-cache: read from the self-hosted HTTP cache. Pass the
# endpoint with --remote_cache=$BAZEL_REMOTE_CACHE_URL (CI writes it to
# user.bazelrc); the credential helper sends BAZEL_REMOTE_CACHE_TOKEN as a
# Bearer token, and only to that endpoint's host. Read-only by default, so
# pull requests and dev hosts can never write.
common:remote-cache --credential_helper=%workspace%/bazel/remote-cache-credentials.sh
common:remote-cache --remote_upload_local_results=false
common:remote-cache --remote_local_fallback
common:remote-cache --remote_timeout=60s

# --config=remote-cache-write: trusted main-branch runs only, with a
# read-write token. The cache server must also reject writes from read-only
# tokens.
common:remote-cache-write --config=remote-cache
common:remote-cache-write --remote_upload_local_results=true
