#!/bin/sh
# Post-install message for the intentd .deb. The package ships a systemd
# *user* unit (/usr/lib/systemd/user/intentd.service); maintainer scripts run
# as root and cannot enable user units for individual users, so the unit is
# intentionally NOT auto-enabled — just print the enable hint.
set -e

if [ "$1" = "configure" ]; then
    echo "intentd installed. To start it now and at every login, run as your user:"
    echo "    systemctl --user enable --now intentd"
    echo "Startup auto-resume of interrupted agents defaults to auto (headless hosts only);"
    echo "toggle it with: intentd settings agents.resumeInterruptedOnStart on|off"
    echo "To use this computer only as a node that runs agents for another Intent,"
    echo "once the service runs:"
    echo "    intentd settings daemon.mode node && intentd settings server.tunnel.enabled true"
    echo "    intentd restart"
    echo "    intentd pair --node --tunnel"
fi

exit 0
